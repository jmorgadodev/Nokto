    <sys:String x:Key="ShowQuickActionsInHome">Mostrar Acciones Rápidas (Temporizador, Rutinas, Modo Dormir)</sys:String>
    <sys:String x:Key="ShowAudioControlCardInHome">Mostrar Configuración y Control de Audio</sys:String>
