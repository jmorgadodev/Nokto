    <sys:String x:Key="HomeBtnViewRoutines">🔄 Ver Rutinas</sys:String>
    <sys:String x:Key="HomeBtnSleepMode">🌙 Modo Dormir</sys:String>

    <sys:String x:Key="WhenToExecute">¿CUÁNDO ACTIVAR?</sys:String>
