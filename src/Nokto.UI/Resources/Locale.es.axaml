    <sys:String x:Key="SettingsStartup">TELETRABAJO Y ARRANQUE</sys:String>
    <sys:String x:Key="SettingsPanicHotkey">ATAJO GLOBAL DE PÁNICO (Panic Hotkey)</sys:String>
    <sys:String x:Key="SettingsBattery">GUARDIÁN DE BATERÍA (Portátiles)</sys:String>
    <sys:String x:Key="SettingsEvidence">EVIDENCIAS Y MANTENIMIENTO</sys:String>
    <sys:String x:Key="SettingsAiOptions">MODULARIDAD E INTELIGENCIA ARTIFICIAL</sys:String>

    <sys:String x:Key="StartWithWindows">Iniciar con Windows</sys:String>
    <sys:String x:Key="StartMinimized">Iniciar minimizado en la bandeja del sistema</sys:String>
    <sys:String x:Key="StartInWorkMode">Iniciar automáticamente en Modo Trabajo (anti-ausente)</sys:String>
    <sys:String x:Key="EnableBatteryProtection">Activar protección de batería</sys:String>
    <sys:String x:Key="TakeEvidenceScreenshots">Tomar capturas de pantalla de evidencia (máx 20)</sys:String>
    <sys:String x:Key="ShowAiRadarInHome">Mostrar Radar de Cuotas IA en pestaña Inicio</sys:String>
    <sys:String x:Key="BtnViewGallery">🖼 Ver Galería de Evidencias</sys:String>
    <sys:String x:Key="BtnOpenData">📂 Abrir carpeta de datos</sys:String>
    <sys:String x:Key="BtnResetSettings">🔄 Restablecer Ajustes</sys:String>
    <sys:String x:Key="TabIsland">◉ Isla Dinámica</sys:String>
    <sys:String x:Key="IslandTitle">ISLA DINÁMICA</sys:String>
    <sys:String x:Key="IslandIntro">Tu nueva interfaz compacta para acceder a Nokto sin abrir la consola completa.</sys:String>
    <sys:String x:Key="IslandVisibilityHeading">ACTIVACIÓN</sys:String>
    <sys:String x:Key="IslandEnable">Mostrar la isla flotante</sys:String>
    <sys:String x:Key="IslandEnableHint">La isla se muestra encima del escritorio y puedes ocultarla cuando quieras.</sys:String>
    <sys:String x:Key="IslandPageSettingsTitle">PERSONALIZA CADA PÁGINA</sys:String>
    <sys:String x:Key="IslandPageSettingsHint">Activa solo lo que quieres ver en cada ventana. Cada sección es independiente; desmarca los botones que te sobren.</sys:String>
    <sys:String x:Key="IslandPageEnabled">Mostrar esta página</sys:String>
    <sys:String x:Key="IslandOverviewMedia">Reproductor musical</sys:String>
    <sys:String x:Key="IslandOverviewBattery">Estado de batería</sys:String>
    <sys:String x:Key="IslandOverviewNetwork">Estado de red</sys:String>
    <sys:String x:Key="IslandWeatherEnable">Clima local</sys:String>
    <sys:String x:Key="IslandWeatherCityHint">Ciudad, país (ej. Valparaíso, Chile)</sys:String>
    <sys:String x:Key="IslandWeatherPrivacy">Consulta solo la ciudad escrita, sin GPS. Caché de 30 min; actualiza al abrir Resumen o al pulsar ↻.</sys:String>
    <sys:String x:Key="IslandSoundVolume">Barra de volumen</sys:String>
    <sys:String x:Key="IslandSoundMic">Botón micrófono</sys:String>
    <sys:String x:Key="IslandSoundMute">Botón silenciar salida</sys:String>
    <sys:String x:Key="IslandSoundWheelHint">Para evitar cambios accidentales, la rueda no ajusta volumen ni cambia sección sobre controles.</sys:String>
    <sys:String x:Key="IslandShortcutsRoutines">Gestor de rutinas</sys:String>
    <sys:String x:Key="IslandShortcutsExplorer">Abrir Explorador</sys:String>
    <sys:String x:Key="IslandShortcutsFolders">Mis carpetas</sys:String>
    <sys:String x:Key="IslandFooterTitle">CONTROLES INFERIORES</sys:String>
    <sys:String x:Key="IslandFooterNokto">Mostrar botón «Nokto»</sys:String>
    <sys:String x:Key="IslandFooterHide">Mostrar botón «Ocultar»</sys:String>
    <sys:String x:Key="IslandFooterHint">Si desactivas ambos, desaparece la fila inferior sin afectar el uso de la isla.</sys:String>
    <sys:String x:Key="IslandNotificationsTitle">AVISOS Y PRIVACIDAD</sys:String>
    <sys:String x:Key="IslandNotificationsEnable">Avisos de Windows para alarmas y recordatorios</sys:String>
    <sys:String x:Key="IslandPrivacyMode">Modo privado: ocultar textos y accesos sensibles</sys:String>
    <sys:String x:Key="IslandNotificationsHint">Avisos del área de notificación de Windows. Pueden depender de las preferencias del sistema.</sys:String>
    <sys:String x:Key="IslandNoIndicator">Sin indicador · solo cápsula</sys:String>
    <sys:String x:Key="IslandWheelEnabled">Cambiar de sección con la rueda del ratón</sys:String>
    <sys:String x:Key="IslandWheelHint">Desplaza la rueda sobre la isla para pasar entre Resumen, Sonido y Accesos. También hay flechas para navegar.</sys:String>
    <sys:String x:Key="IslandQuickHeading">ACCESOS DIRECTOS</sys:String>
    <sys:String x:Key="IslandQuickEnabled">Mostrar Explorador y carpetas personalizadas</sys:String>
    <sys:String x:Key="IslandQuickHint">La lista de carpetas se administra desde la sección Accesos de la propia isla.</sys:String>
    <sys:String x:Key="IslandRoutinesInfo">Las rutinas y los temporizadores se gestionan desde el gestor principal de Nokto, sin duplicar formularios en la isla.</sys:String>
    <sys:String x:Key="IslandOpenRoutines">Abrir gestor de rutinas</sys:String>
    <sys:String x:Key="IslandClipboardHeading">PORTAPAPELES · FASE 7</sys:String>
    <sys:String x:Key="IslandClipboardEnable">Habilitar lectura manual del texto copiado (sin historial)</sys:String>
    <sys:String x:Key="IslandPageOverview">Resumen</sys:String>
    <sys:String x:Key="IslandPageAudio">Sonido</sys:String>
    <sys:String x:Key="IslandPageShortcuts">Accesos</sys:String>
    <sys:String x:Key="IslandExplorer">Abrir Explorador</sys:String>
    <sys:String x:Key="IslandChooseFolder">Añadir carpeta</sys:String>
    <sys:String x:Key="IslandOpenFolder">Abrir carpeta</sys:String>
    <sys:String x:Key="IslandRemoveFolder">Quitar acceso</sys:String>
    <sys:String x:Key="IslandClipboardRead">Ver texto copiado</sys:String>
    <sys:String x:Key="IslandAppearanceHeading">APARIENCIA Y MODOS COMPACTOS</sys:String>
    <sys:String x:Key="IslandStyleLabel">Indicador de la isla</sys:String>
    <sys:String x:Key="IslandStyleEyes">Ojos Nokto · Clásicos</sys:String>
    <sys:String x:Key="IslandStyleGreen">Punto verde</sys:String>
    <sys:String x:Key="IslandStyleBlack">Punto negro</sys:String>
    <sys:String x:Key="IslandStyleGlow">Punto cian luminoso</sys:String>
    <sys:String x:Key="IslandShowClock">Mostrar reloj en la isla</sys:String>
    <sys:String x:Key="IslandClockBehavior">VISIBILIDAD DEL RELOJ</sys:String>
    <sys:String x:Key="IslandClockExpand">Solo al expandir (recomendado)</sys:String>
    <sys:String x:Key="IslandClockAlways">Siempre visible</sys:String>
    <sys:String x:Key="IslandClockNever">Ocultar reloj</sys:String>
    <sys:String x:Key="IslandTestEyes">Probar ojos</sys:String>
    <sys:String x:Key="IslandOpenDashboard">Nokto</sys:String>
    <sys:String x:Key="IslandHideIsland">Ocultar</sys:String>
    <sys:String x:Key="IslandMediaHeading">MULTIMEDIA</sys:String>
    <sys:String x:Key="IslandMediaControls">Mostrar reproductor al expandir</sys:String>
    <sys:String x:Key="IslandMediaCompact">Mostrar canción en modo compacto (si hay reproducción)</sys:String>
    <sys:String x:Key="IslandMediaNote">Se usan las sesiones multimedia de Windows. Algunos reproductores no proporcionan metadatos ni controles. No se captura el audio.</sys:String>
    <sys:String x:Key="IslandSystemControls">CONTROLES DE WINDOWS</sys:String>
    <sys:String x:Key="IslandShowAudioControls">Micrófono, audio y volumen</sys:String>
    <sys:String x:Key="IslandShowBatteryStatus">Estado de batería</sys:String>
    <sys:String x:Key="IslandShowNetworkStatus">Estado de conexión de red</sys:String>
    <sys:String x:Key="IslandProductivityHeading">PRODUCTIVIDAD</sys:String>
    <sys:String x:Key="IslandProductivityEnabled">Activar productividad en la isla</sys:String>
    <sys:String x:Key="IslandProductivityCompact">Mostrar cuenta atrás en la isla compacta</sys:String>
    <sys:String x:Key="IslandProductivitySound">Reproducir aviso sonoro al finalizar</sys:String>
    <sys:String x:Key="IslandFocusMinutes">Minutos de enfoque</sys:String>
    <sys:String x:Key="IslandBreakMinutes">Minutos de descanso</sys:String>
    <sys:String x:Key="IslandProductivityNote">Temporizador, cronómetro, Pomodoro, tareas y alarmas locales. Los avisos necesitan Nokto abierto; no despiertan el PC suspendido ni se envían si la app está cerrada.</sys:String>
    <sys:String x:Key="IslandShelfHeading">ARCHIVOS LOCALES</sys:String>
    <sys:String x:Key="IslandShelfToggle">Mostrar bandeja de archivos en la isla</sys:String>
    <sys:String x:Key="IslandShelfInfo">Puedes elegir hasta seis archivos locales. Nokto solo guarda su ubicación, nunca copia contenido ni utiliza la red. Abre archivos únicamente al pulsarlos.</sys:String>
    <sys:String x:Key="IslandPerformanceHeading">RENDIMIENTO Y ANIMACIONES</sys:String>
    <sys:String x:Key="IslandPerformanceDescription">Nokto detecta la frecuencia del monitor donde se muestra la isla y adapta su animación. Puedes limitarla manualmente.</sys:String>
    <sys:String x:Key="IslandAnimationRateLabel">Actualización de animaciones</sys:String>
    <sys:String x:Key="IslandFpsAuto">Automático (recomendado)</sys:String>
    <sys:String x:Key="IslandDetectedRateLabel">Pantalla / objetivo:</sys:String>
    <sys:String x:Key="IslandPerformanceNote">Los FPS son un objetivo de interpolación, no una garantía de fotogramas renderizados. En reposo no hay animación continua.</sys:String>
    <sys:String x:Key="IslandExpandOnHover">Expandir al acercar el cursor</sys:String>
    <sys:String x:Key="IslandReducedMotion">Reducir movimiento (sin transiciones)</sys:String>
    <sys:String x:Key="IslandGalleryGuide">Selecciona un diseño directamente en la galería: se aplicará al instante. El contorno verde indica el estilo activo.</sys:String>
    <sys:String x:Key="IslandGalleryFilter">Filtrar familia</sys:String>
    <sys:String x:Key="IslandGalleryAll">Todas las familias</sys:String>
    <sys:String x:Key="IslandSizeLabel">Tamaño de la isla</sys:String>
    <sys:String x:Key="IslandSizeHint">80 % a 140 %. Escala ojos, controles y ventana al mismo tiempo; 100 % es el tamaño original.</sys:String>
    <sys:String x:Key="IslandGalleryHeading">Galería de las 42 apariencias</sys:String>
    <sys:String x:Key="IslandEyePreview">VISTA PREVIA</sys:String>
    <sys:String x:Key="IslandEyeMotionHeading">MIRADA Y COMPORTAMIENTO</sys:String>
    <sys:String x:Key="IslandFollowCursor">Seguir el cursor por el escritorio</sys:String>
    <sys:String x:Key="IslandNaturalBlink">Parpadeo natural aleatorio</sys:String>
    <sys:String x:Key="IslandSleepOnIdle">Dormir después de 60 segundos sin movimiento</sys:String>
    <sys:String x:Key="IslandEyeSensitivity">Sensibilidad de la mirada</sys:String>
    <sys:String x:Key="IslandEyeMotionNote">Los ojos reaccionan con animaciones breves; en modo discreto o movimiento reducido no se rastrea el cursor. No se guardan sus coordenadas.</sys:String>
    <sys:String x:Key="IslandAppearanceHint">42 estilos vectoriales originales en siete familias. Solo se dibuja el estilo seleccionado.</sys:String>
    <sys:String x:Key="IslandStartupHeading">INICIO DE NOKTO</sys:String>
    <sys:String x:Key="IslandStartupDescription">Selecciona qué interfaz aparecerá al abrir Nokto. La opción Iniciar con Windows continúa siendo voluntaria en Ajustes.</sys:String>
    <sys:String x:Key="IslandStartupLegacy">Conservar inicio anterior</sys:String>
    <sys:String x:Key="IslandStartupDashboard">Solo dashboard</sys:String>
    <sys:String x:Key="IslandStartupIsland">Solo isla dinámica</sys:String>
    <sys:String x:Key="IslandStartupBoth">Dashboard e isla</sys:String>
    <sys:String x:Key="IslandStartupTray">Solo bandeja, sin ventanas</sys:String>
    <sys:String x:Key="IslandStartupNote">Al seleccionar Solo isla, el dashboard se abrirá únicamente cuando lo solicites. La isla debe estar activada.</sys:String>
    <sys:String x:Key="IslandNextSteps">Nokto 2.0 DEV · Módulo inicial. El resto de funcionalidades se incorporará y probará por fases.</sys:String>
</ResourceDictionary>
