<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="TabHome">◈ Home</sys:String>
    <sys:String x:Key="TabManual">⏱ Manual Control</sys:String>
    <sys:String x:Key="TabQuick">⚡ Quick Actions</sys:String>
    <sys:String x:Key="TabRoutines">🔄 Routines</sys:String>
    <sys:String x:Key="TabSettings">⚙ Settings</sys:String>

    <sys:String x:Key="HomeConnection">LOCAL NETWORK &amp; CONNECTION</sys:String>
    <sys:String x:Key="HomeWorkAndPower">WORK &amp; POWER STATE</sys:String>
    <sys:String x:Key="HomeAiRadar">AI TOOLS RADAR</sys:String>
    <sys:String x:Key="HomeHardwareSpecifications">WORKSTATION</sys:String>
    <sys:String x:Key="SettingsDiskSpace">SYSTEM DISK SPACE</sys:String>
    <sys:String x:Key="DiskAlertPrompt">Notify when free space drops below</sys:String>
    <sys:String x:Key="SettingsHomeModularity">HOME DASHBOARD MODULARITY</sys:String>
    <sys:String x:Key="ShowNetworkCardInHome">Show Local Network and VPN Diagnostics</sys:String>
    <sys:String x:Key="ShowEnergyStatusCardInHome">Show Work Mode and Power Status</sys:String>
    <sys:String x:Key="ShowHardwareCardInHome">Show Hardware and System Specifications</sys:String>
    <sys:String x:Key="ShowAiRadarCardInHome">Show AI Tools Radar</sys:String>
    <sys:String x:Key="ShowQuickActionsInHome">Show Quick Actions (Timer, Routines, Sleep Mode)</sys:String>
    <sys:String x:Key="ShowAudioControlCardInHome">Show Audio Configuration and Controls</sys:String>
    <sys:String x:Key="HomeQuickActions">QUICK ACTIONS</sys:String>
    <sys:String x:Key="HomeBtnQuickTimer">⏱ Quick Timer</sys:String>
    <sys:String x:Key="HomeBtnViewRoutines">🔄 View Routines</sys:String>
    <sys:String x:Key="HomeBtnSleepMode">🌙 Sleep Mode</sys:String>

    <sys:String x:Key="WhenToExecute">WHEN TO ACTIVATE?</sys:String>
    <sys:String x:Key="WhatToDo">WHAT TO DO NEXT? (Intermediate actions in series)</sys:String>
    <sys:String x:Key="HowToFinish">WHAT SHOULD HAPPEN AT THE END?</sys:String>
    <sys:String x:Key="WhenToActivateLabel">When to activate?</sys:String>
    <sys:String x:Key="OnCompletionLabel">What should happen at the end?</sys:String>
    <sys:String x:Key="FadeAudioLabel">Lower volume gradually</sys:String>
    <sys:String x:Key="PreExecutionNoticeLabel">Show a notice before executing</sys:String>
    <sys:String x:Key="PreExecutionNoticeRange">Show a notice before executing (0 to 300 seconds):</sys:String>

    <sys:String x:Key="BtnVerifyRoutine">🔍 Verify Routine</sys:String>
    <sys:String x:Key="BtnSaveRoutine">💾 Save Routine</sys:String>
    <sys:String x:Key="BtnStartRoutine">▶ START ROUTINE</sys:String>
    <sys:String x:Key="BtnStartTimer">▶ START TIMER</sys:String>
    <sys:String x:Key="BtnFinish">⏹ FINISH</sys:String>
    <sys:String x:Key="BtnDelete">🗑 Delete</sys:String>
    <sys:String x:Key="BtnRestoreFactory">↺ Restore Factory Routines</sys:String>
    <sys:String x:Key="BtnNewRoutine">+ New Routine</sys:String>

    <sys:String x:Key="SettingsLanguage">LANGUAGE</sys:String>
    <sys:String x:Key="SettingsAppearance">APPEARANCE</sys:String>
    <sys:String x:Key="SettingsStartup">TELEWORK &amp; STARTUP</sys:String>
    <sys:String x:Key="SettingsPanicHotkey">PANIC GLOBAL HOTKEY (Panic Hotkey)</sys:String>
    <sys:String x:Key="SettingsBattery">BATTERY GUARDIAN (Laptops)</sys:String>
    <sys:String x:Key="SettingsEvidence">EVIDENCE &amp; MAINTENANCE</sys:String>
    <sys:String x:Key="SettingsAiOptions">MODULARITY &amp; AI INTEGRATION</sys:String>

    <sys:String x:Key="StartWithWindows">Start with Windows</sys:String>
    <sys:String x:Key="StartMinimized">Start minimized to system tray</sys:String>
    <sys:String x:Key="StartInWorkMode">Start automatically in Work Mode (anti-away)</sys:String>
    <sys:String x:Key="EnableBatteryProtection">Enable battery protection</sys:String>
    <sys:String x:Key="TakeEvidenceScreenshots">Take evidence screenshots (max 20)</sys:String>
    <sys:String x:Key="ShowAiRadarInHome">Show AI Quota Radar in Home tab</sys:String>
    <sys:String x:Key="BtnViewGallery">🖼 View Evidence Gallery</sys:String>
    <sys:String x:Key="BtnOpenData">📂 Open data folder</sys:String>
    <sys:String x:Key="BtnResetSettings">🔄 Reset Settings</sys:String>
    <sys:String x:Key="TabIsland">◉ Dynamic Island</sys:String>
    <sys:String x:Key="IslandTitle">DYNAMIC ISLAND</sys:String>
    <sys:String x:Key="IslandIntro">Your compact desktop interface for quick access to Nokto without opening the full console.</sys:String>
    <sys:String x:Key="IslandVisibilityHeading">ACTIVATION</sys:String>
    <sys:String x:Key="IslandEnable">Show the floating island</sys:String>
    <sys:String x:Key="IslandEnableHint">The island appears on your desktop and can be hidden at any time.</sys:String>
    <sys:String x:Key="IslandPageSettingsTitle">PERSONALIZE EACH PAGE</sys:String>
    <sys:String x:Key="IslandModule">Module</sys:String>
    <sys:String x:Key="IslandMediaPreviousLabel">Previous</sys:String>
    <sys:String x:Key="IslandMediaNextLabel">Next</sys:String>
    <sys:String x:Key="IslandMediaPlayLabel">Play</sys:String>
    <sys:String x:Key="IslandMediaPauseLabel">Pause</sys:String>
    <sys:String x:Key="IslandMediaPlayingState">PLAYING</sys:String>
    <sys:String x:Key="IslandMediaPausedState">PAUSED</sys:String>
    <sys:String x:Key="IslandPageSettingsHint">Choose exactly what to show in each island page. Remove any controls you don't need.</sys:String>
    <sys:String x:Key="IslandPageEnabled">Show this page</sys:String>
    <sys:String x:Key="IslandOverviewMedia">Music player</sys:String>
    <sys:String x:Key="IslandOverviewBattery">Battery status</sys:String>
    <sys:String x:Key="IslandOverviewNetwork">Network status</sys:String>
    <sys:String x:Key="IslandWeatherEnable">Local weather</sys:String>
    <sys:String x:Key="IslandWeatherCityHint">City, country (e.g. Paris, France)</sys:String>
    <sys:String x:Key="IslandWeatherPrivacy">Only the typed city is used, never GPS. 30-minute cache; refresh on Overview or ↻.</sys:String>
    <sys:String x:Key="IslandSoundVolume">Volume slider</sys:String>
    <sys:String x:Key="IslandSoundMic">Microphone button</sys:String>
    <sys:String x:Key="IslandSoundMute">Mute output button</sys:String>
    <sys:String x:Key="IslandSoundWheelHint">To prevent accidental changes, the wheel does not alter volume or pages over controls.</sys:String>
    <sys:String x:Key="IslandShortcutsRoutines">Routines manager</sys:String>
    <sys:String x:Key="IslandShortcutsExplorer">Open Explorer</sys:String>
    <sys:String x:Key="IslandShortcutsFolders">My folders</sys:String>
    <sys:String x:Key="IslandFooterTitle">BOTTOM CONTROLS</sys:String>
    <sys:String x:Key="IslandFooterNokto">Show «Nokto» button</sys:String>
    <sys:String x:Key="IslandFooterHide">Show «Hide» button</sys:String>
    <sys:String x:Key="IslandFooterHint">Unchecking both removes the bottom row while keeping the island functional.</sys:String>
    <sys:String x:Key="IslandNotificationsTitle">ALERTS &amp; PRIVACY</sys:String>
    <sys:String x:Key="IslandNotificationsEnable">Windows alerts for alarms and reminders</sys:String>
    <sys:String x:Key="IslandPrivacyMode">Private mode: hide sensitive labels and shortcuts</sys:String>
    <sys:String x:Key="IslandNotificationsHint">Uses Windows notification-area alerts. Display depends on system preferences.</sys:String>
    <sys:String x:Key="IslandNoIndicator">No indicator · pill only</sys:String>
    <sys:String x:Key="IslandWheelEnabled">Use mouse wheel to switch island sections</sys:String>
    <sys:String x:Key="IslandWheelHint">Scroll over the island to switch between Overview, Sound and Shortcuts. Navigation arrows are available too.</sys:String>
    <sys:String x:Key="IslandQuickHeading">SHORTCUTS</sys:String>
    <sys:String x:Key="IslandQuickEnabled">Show Explorer and custom folders</sys:String>
    <sys:String x:Key="IslandQuickHint">Manage folders in the island's Shortcuts section.</sys:String>
    <sys:String x:Key="IslandRoutinesInfo">Manage routines and timers in the main Nokto dashboard, rather than duplicating their settings in the island.</sys:String>
    <sys:String x:Key="IslandOpenRoutines">Open routines manager</sys:String>
    <sys:String x:Key="IslandClipboardHeading">CLIPBOARD · PHASE 7</sys:String>
    <sys:String x:Key="IslandClipboardEnable">Allow manual reading of copied text (no history)</sys:String>
    <sys:String x:Key="IslandPageOverview">Overview</sys:String>
    <sys:String x:Key="IslandPageAudio">Sound</sys:String>
    <sys:String x:Key="IslandPageShortcuts">Shortcuts</sys:String>
    <sys:String x:Key="IslandExplorer">Open Explorer</sys:String>
    <sys:String x:Key="IslandChooseFolder">Add folder</sys:String>
    <sys:String x:Key="IslandOpenFolder">Open folder</sys:String>
    <sys:String x:Key="IslandRemoveFolder">Remove shortcut</sys:String>
    <sys:String x:Key="IslandClipboardRead">View copied text</sys:String>
    <sys:String x:Key="IslandAppearanceHeading">APPEARANCE AND COMPACT MODES</sys:String>
    <sys:String x:Key="IslandStyleLabel">Island indicator</sys:String>
    <sys:String x:Key="IslandStyleEyes">Nokto Eyes · Classic</sys:String>
    <sys:String x:Key="IslandStyleGreen">Green dot</sys:String>
    <sys:String x:Key="IslandStyleBlack">Black dot</sys:String>
    <sys:String x:Key="IslandStyleGlow">Glowing cyan dot</sys:String>
    <sys:String x:Key="IslandShowClock">Show clock in island</sys:String>
    <sys:String x:Key="IslandClockBehavior">CLOCK VISIBILITY</sys:String>
    <sys:String x:Key="IslandClockExpand">Only when expanded (recommended)</sys:String>
    <sys:String x:Key="IslandClockAlways">Always visible</sys:String>
    <sys:String x:Key="IslandClockNever">Hide clock</sys:String>
    <sys:String x:Key="IslandTestEyes">Test eyes</sys:String>
    <sys:String x:Key="IslandOpenDashboard">Nokto</sys:String>
    <sys:String x:Key="IslandHideIsland">Hide</sys:String>
    <sys:String x:Key="IslandMediaHeading">MEDIA</sys:String>
    <sys:String x:Key="IslandMediaControls">Show player when expanded</sys:String>
    <sys:String x:Key="IslandMediaCompact">Show song in compact mode (during playback)</sys:String>
    <sys:String x:Key="IslandMediaNote">Uses Windows media sessions. Some players do not expose metadata or controls. Audio is not captured.</sys:String>
    <sys:String x:Key="IslandSystemControls">WINDOWS CONTROLS</sys:String>
    <sys:String x:Key="IslandShowAudioControls">Microphone, output and volume</sys:String>
    <sys:String x:Key="IslandShowBatteryStatus">Battery status</sys:String>
    <sys:String x:Key="IslandShowNetworkStatus">Network connection status</sys:String>
    <sys:String x:Key="IslandProductivityHeading">PRODUCTIVITY</sys:String>
    <sys:String x:Key="IslandProductivityEnabled">Enable productivity in the island</sys:String>
    <sys:String x:Key="IslandProductivityCompact">Show countdown on compact island</sys:String>
    <sys:String x:Key="IslandProductivitySound">Play sound when a timer or reminder finishes</sys:String>
    <sys:String x:Key="IslandFocusMinutes">Focus minutes</sys:String>
    <sys:String x:Key="IslandBreakMinutes">Break minutes</sys:String>
    <sys:String x:Key="IslandProductivityNote">Local countdown, stopwatch, Pomodoro, tasks and alarms. Notifications require Nokto running; they do not wake a sleeping PC or fire while the app is closed.</sys:String>
    <sys:String x:Key="IslandShelfHeading">LOCAL FILES</sys:String>
    <sys:String x:Key="IslandShelfToggle">Show file shelf in island</sys:String>
    <sys:String x:Key="IslandShelfInfo">Choose up to six local files. Nokto stores their locations only; it never copies their contents or connects to a server. Files open only after you click them.</sys:String>
    <sys:String x:Key="IslandPerformanceHeading">PERFORMANCE AND ANIMATIONS</sys:String>
    <sys:String x:Key="IslandPerformanceDescription">Nokto detects the refresh rate of the island's screen and adapts its animations. You may set a manual limit.</sys:String>
    <sys:String x:Key="IslandAnimationRateLabel">Animation update rate</sys:String>
    <sys:String x:Key="IslandFpsAuto">Automatic (recommended)</sys:String>
    <sys:String x:Key="IslandDetectedRateLabel">Display / target:</sys:String>
    <sys:String x:Key="IslandPerformanceNote">FPS is an interpolation target, not guaranteed rendered frames. No continuous animation runs while idle.</sys:String>
    <sys:String x:Key="IslandExpandOnHover">Expand when hovering</sys:String>
    <sys:String x:Key="IslandReducedMotion">Reduce motion (no transitions)</sys:String>
    <sys:String x:Key="IslandGalleryGuide">Click a design to use it immediately. The green outline marks the current selection.</sys:String>
    <sys:String x:Key="IslandGalleryFilter">Filter family</sys:String>
    <sys:String x:Key="IslandGalleryAll">All families</sys:String>
    <sys:String x:Key="IslandSizeLabel">Island size</sys:String>
    <sys:String x:Key="IslandSizeHint">80 % to 140 %. Eyes, controls and window scale together; 100 % is the original size.</sys:String>
    <sys:String x:Key="IslandGalleryHeading">Gallery of all 42 appearances</sys:String>
    <sys:String x:Key="IslandEyePreview">PREVIEW</sys:String>
    <sys:String x:Key="IslandEyeMotionHeading">GAZE AND BEHAVIOR</sys:String>
    <sys:String x:Key="IslandFollowCursor">Follow cursor across the desktop</sys:String>
    <sys:String x:Key="IslandNaturalBlink">Natural randomized blinking</sys:String>
    <sys:String x:Key="IslandSleepOnIdle">Fall asleep after 60 seconds without movement</sys:String>
    <sys:String x:Key="IslandEyeSensitivity">Gaze sensitivity</sys:String>
    <sys:String x:Key="IslandEyeMotionNote">Eyes react with short animations; discrete and reduced-motion modes do not track your cursor. Coordinates are not saved.</sys:String>
    <sys:String x:Key="IslandAppearanceHint">Choose from seven families of vector styles. Only the selected style is rendered.</sys:String>
    <sys:String x:Key="IslandStartupHeading">NOKTO STARTUP</sys:String>
    <sys:String x:Key="IslandStartupDescription">Choose the interface shown when launching Nokto. Starting with Windows remains optional in Settings.</sys:String>
    <sys:String x:Key="IslandStartupLegacy">Keep previous startup behavior</sys:String>
    <sys:String x:Key="IslandStartupDashboard">Dashboard only</sys:String>
    <sys:String x:Key="IslandStartupIsland">Dynamic island only</sys:String>
    <sys:String x:Key="IslandStartupBoth">Dashboard and island</sys:String>
    <sys:String x:Key="IslandStartupTray">System tray only</sys:String>
    <sys:String x:Key="IslandStartupNote">Island-only mode keeps the dashboard hidden until you open it. Enable the island first.</sys:String>
    <sys:String x:Key="IslandNextSteps">Nokto 2.0 DEV · Initial module. Additional features will be added and tested in stages.</sys:String>
</ResourceDictionary>
