<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Nokto.UI.ViewModels" xmlns:models="using:Nokto.Core.Models" xmlns:views="using:Nokto.UI.Views"
 x:Class="Nokto.UI.Views.ManualControlView" x:DataType="vm:MainViewModel" x:CompileBindings="True">
 <UserControl.Styles>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="TextBlock.heading"><Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
  <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource ThemeInputBackground}"/><Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="Expander"><Setter Property="Background" Value="{DynamicResource ThemeInputBackground}"/></Style>
  <Style Selector="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource ThemeInputBackground}"/><Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/></Style>
  <Style Selector="ComboBox"><Setter Property="Background" Value="{DynamicResource ThemeInputBackground}"/><Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
 </UserControl.Styles>
 <Grid RowDefinitions="*,Auto">
 <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="20,14">
  <StackPanel Spacing="14">
   <TextBlock Classes="hint" Text="Una tarea puntual: elige cuándo, selecciona las acciones y activa. Puedes mantener varias tareas en curso."/>
   <Grid ColumnDefinitions="320,14,*">
    <Border Classes="card" Grid.Column="0" VerticalAlignment="Top">
     <StackPanel Spacing="12">
      <TextBlock Classes="heading" Text="1 · CUÁNDO ACTIVAR"/>
      <WrapPanel>
       <Button Content="Cuenta atrás" Command="{Binding ChooseManualConditionCommand}" CommandParameter="0" Margin="0,0,6,6"/>
       <Button Content="Ahora" Command="{Binding ChooseManualConditionCommand}" CommandParameter="6" Margin="0,0,6,6"/>
       <Button Content="Hora concreta" Command="{Binding ChooseManualConditionCommand}" CommandParameter="1" Margin="0,0,6,6"/>
       <Button Content="Inactividad" Command="{Binding ChooseManualConditionCommand}" CommandParameter="2" Margin="0,0,6,6"/>
      </WrapPanel>
      <TextBlock Classes="hint" Text="{Binding ManualConditionLabel}"/>
      <TextBlock IsVisible="{Binding IsTriggerNow}" Classes="hint" Text="La tarea se activa al pulsar Ejecutar ahora. Si habilitas el aviso previo, las acciones esperan a que termine."/>
                                    <Border IsVisible="{Binding IsTriggerCountdown}" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Tiempo de espera:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding FormattedCountdownText}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 3 CONTADORES ERGONÓMICOS: HORAS, MINUTOS, SEGUNDOS -->
                                            <Grid ColumnDefinitions="*,*,*">
                                                <Border Grid.Column="0" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,4,0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="HORAS" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap"/>
                                                        <NumericUpDown ShowButtonSpinner="False" Value="{Binding CountdownHours, Mode=TwoWay}" Minimum="0" Maximum="99" Increment="1" FormatString="0" HorizontalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="15"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="2,0,2,0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="MINUTOS" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap"/>
                                                        <NumericUpDown ShowButtonSpinner="False" Value="{Binding CountdownMinutes, Mode=TwoWay}" Minimum="0" Maximum="59" Increment="1" FormatString="0" HorizontalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="15"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="4,0,0,0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="SEGUNDOS" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap"/>
                                                        <NumericUpDown ShowButtonSpinner="False" Value="{Binding CountdownSeconds, Mode=TwoWay}" Minimum="0" Maximum="59" Increment="1" FormatString="0" HorizontalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="15"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- BOTONES DE ACCIÓN RÁPIDA -->
                                            <WrapPanel HorizontalAlignment="Left" Margin="0,4,0,0">
                                                <Button Content="+5m" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="5" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Padding="6,4" Margin="0,0,4,4"/>
                                                <Button Content="+15m" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="15" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Padding="6,4" Margin="0,0,4,4"/>
                                                <Button Content="+30m" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="30" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Padding="6,4" Margin="0,0,4,4"/>
                                                <Button Content="+45m" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="45" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Padding="6,4" Margin="0,0,4,4"/>
                                                <Button Content="+1h" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="60" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Padding="6,4" Margin="0,0,4,4"/>
                                                <Button Content="+2h" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="120" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Padding="6,4" Margin="0,0,4,4"/>
                                                <Button Content="Restablecer" Command="{Binding ResetCountdownCommand}" Background="#3A1A1E" Foreground="#FF5252" FontWeight="SemiBold" FontSize="11" Padding="6,4" Margin="0,0,4,4" ToolTip.Tip="Restablecer contador a 00:00:00"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANEL DINÁMICO 2: HORA EXACTA -->
                                    <Border IsVisible="{Binding IsTriggerExactTime}" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Seleccione la hora de ejecución:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11"/>
                                            <TimePicker SelectedTime="{Binding ExactTime, Mode=TwoWay}" HorizontalAlignment="Center" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                            <TextBlock Text="{Binding ExactTimeSummaryText}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANEL DINÁMICO 3: INACTIVIDAD -->
                                    <Border IsVisible="{Binding IsTriggerInactivity}" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Tiempo de inactividad de teclado y ratón:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <NumericUpDown Grid.Column="0" Value="{Binding InactivityMinutes, Mode=TwoWay}" Minimum="1" Maximum="1440" Increment="5" FormatString="0" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                <TextBlock Grid.Column="1" Text="minutos" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>


      <Expander Header="Otras condiciones" HorizontalAlignment="Stretch" IsExpanded="{Binding IsOtherManualCondition, Mode=OneWay}">
       <StackPanel Spacing="10" Margin="0,8,0,0">
        <ComboBox ItemsSource="{Binding ManualOtherConditions}" SelectedIndex="{Binding ManualOtherConditionIndex, Mode=TwoWay}" PlaceholderText="Elegir condición"/>
        <StackPanel IsVisible="{Binding IsTriggerProcessExit}" Spacing="6">
         <TextBlock Classes="hint" Text="Esperar a que termine este proceso:"/>
         <ComboBox ItemsSource="{Binding AvailableProcesses}" SelectedItem="{Binding SelectedProcessName, Mode=TwoWay}" PlaceholderText="Seleccionar proceso"/>
         <Button Content="Actualizar procesos" Command="{Binding RefreshManualProcessesCommand}"/>
         <TextBlock Classes="hint" Text="Margen de estabilización (segundos)"/>
         <NumericUpDown Value="{Binding DebounceSeconds, Mode=TwoWay}" Minimum="0" Maximum="60" FormatString="0"/>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsTriggerAudioSilence}" Spacing="6">
         <TextBlock Classes="hint" Text="Segundos continuos sin sonido:"/>
         <NumericUpDown Value="{Binding AudioSilenceSeconds, Mode=TwoWay}" Minimum="1" Maximum="3600" FormatString="0"/>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsTriggerBatteryState}" Spacing="6">
         <CheckBox IsChecked="{Binding BatteryTriggerOnAcDisconnect, Mode=TwoWay}"><TextBlock Text="Al desconectar la corriente" TextWrapping="Wrap"/></CheckBox>
         <CheckBox IsChecked="{Binding BatteryTriggerOnThreshold, Mode=TwoWay}"><TextBlock Text="Cuando la batería alcance el umbral" TextWrapping="Wrap"/></CheckBox>
         <NumericUpDown IsEnabled="{Binding BatteryTriggerOnThreshold}" Value="{Binding BatteryThresholdPercent, Mode=TwoWay}" Minimum="1" Maximum="100" FormatString="0'%'"/>
         <TextBlock Classes="hint" Text="Si seleccionas ambas, basta con que se cumpla una."/>
        </StackPanel>
       </StackPanel>
      </Expander>
     </StackPanel>
    </Border>
    <Border Classes="card" Grid.Column="2">
     <StackPanel Spacing="12">
      <TextBlock Classes="heading" Text="2 · QUÉ EJECUTAR"/>
      <TextBlock Text="Energía" FontWeight="SemiBold"/>
      <ComboBox Name="ManualEnergyPicker" ItemsSource="{Binding ManualPowerActionOptions}" SelectedIndex="{Binding ManualPowerActionIndex, Mode=TwoWay}"/>

      <Expander Name="ManualApplicationsExpander" Header="Aplicaciones" IsExpanded="False" HorizontalAlignment="Stretch">
       <StackPanel Spacing="8" Margin="0,8,0,0">
        <TextBlock Text="Abrir aplicaciones" FontWeight="SemiBold"/>
        <TextBox Text="{Binding ManualAppSearch, Mode=TwoWay}" Watermark="Buscar en aplicaciones detectadas"/>
        <ComboBox Name="ManualInstalledAppPicker" ItemsSource="{Binding ManualFilteredApps}" SelectedItem="{Binding SelectedManualInstalledApp, Mode=TwoWay}" PlaceholderText="Seleccionar aplicación">
         <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:InstalledAppInfo"><Grid ColumnDefinitions="24,*"><Image Source="{Binding Icon}" Width="20" Height="20"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="hint" Text="{Binding InstalledAppsStatusText}"/>
        <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding ManualExecutablePath, Mode=TwoWay}" Watermark="O escribe la ruta de un ejecutable"/><Button Grid.Column="1" Content="Examinar…" Command="{Binding BrowseManualAppCommand}" Margin="8,0,0,0"/></Grid>
        <Expander Header="Opciones de apertura" HorizontalAlignment="Stretch">
         <StackPanel Spacing="6" Margin="0,6,0,0"><TextBox Text="{Binding ManualAppArguments, Mode=TwoWay}" Watermark="Argumentos (opcional)"/><TextBox Text="{Binding ManualAppWorkingDirectory, Mode=TwoWay}" Watermark="Carpeta de trabajo (opcional)"/><ComboBox ItemsSource="{Binding ManualLaunchModes}" SelectedIndex="{Binding ManualLaunchModeIndex, Mode=TwoWay}"/><CheckBox Content="Omitir si ya está abierta" IsChecked="{Binding ManualSkipIfAlreadyRunning, Mode=TwoWay}"/></StackPanel>
        </Expander>
        <Button Name="AddManualAppButton" Content="+ Añadir aplicación" Command="{Binding AddManualAppCommand}"/>
        <ItemsControl ItemsSource="{Binding ManualLaunchApplications}">
         <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ManualLaunchSelection"><Grid ColumnDefinitions="*,Auto" Margin="0,3"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip.Tip="{Binding Options.ExecutablePath}"/><Button Grid.Column="1" Content="Quitar" Command="{ReflectionBinding $parent[UserControl].DataContext.RemoveManualAppCommand}" CommandParameter="{Binding}" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Expander Header="Cerrar ventanas o aplicaciones" HorizontalAlignment="Stretch">
         <StackPanel Spacing="8" Margin="0,8,0,0">
          <Button Content="Actualizar ventanas abiertas" Command="{Binding RefreshManualWindowsCommand}"/>
          <ComboBox Name="ManualWindowPicker" ItemsSource="{Binding ManualAvailableWindows}" SelectedItem="{Binding SelectedManualWindow, Mode=TwoWay}" PlaceholderText="Seleccionar ventana">
           <ComboBox.ItemTemplate><DataTemplate x:DataType="models:ApplicationWindow"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox IsChecked="{Binding ManualCloseAllWindows, Mode=TwoWay}"><TextBlock Text="Cerrar todas las ventanas de esta aplicación" TextWrapping="Wrap"/></CheckBox>
          <Button Content="+ Añadir objetivo de cierre" Command="{Binding AddManualCloseTargetCommand}"/>
          <TextBlock Classes="hint" Text="Cierre normal. Si una aplicación sigue abierta tras 15 segundos, la tarea se detiene para que revises sus cambios pendientes."/>
          <CheckBox IsChecked="{Binding ManualCloseForegroundApps, Mode=TwoWay}"><TextBlock Text="Cerrar la aplicación en primer plano al ejecutar (avanzado)" TextWrapping="Wrap"/></CheckBox>
          <TextBlock IsVisible="{Binding ManualCloseForegroundApps}" Classes="hint" Text="El objetivo será la aplicación que tenga el foco en ese momento; puede cambiar durante la espera. Nokto se excluye."/>
         </StackPanel>
        </Expander>
        <ItemsControl ItemsSource="{Binding ManualCloseApplications}">
         <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ManualCloseSelection"><Grid ColumnDefinitions="*,Auto" Margin="0,3"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Quitar" Command="{ReflectionBinding $parent[UserControl].DataContext.RemoveManualCloseTargetCommand}" CommandParameter="{Binding}" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Expander>
      <Expander Header="Audio, pantalla y sesión" HorizontalAlignment="Stretch">
       <StackPanel Spacing="4" Margin="0,6,0,0">
        <CheckBox Content="Silenciar salida de audio" IsChecked="{Binding ManualMuteOutput, Mode=TwoWay}"/>
        <CheckBox Content="Silenciar micrófono" IsChecked="{Binding ManualMuteMicrophone, Mode=TwoWay}"/>
        <CheckBox Content="Pausar reproducción multimedia" IsChecked="{Binding ManualPauseMedia, Mode=TwoWay}"/>
        <CheckBox IsChecked="{Binding ManualAudioFadeEnabled, Mode=TwoWay}"><TextBlock Text="Bajar volumen a 0% gradualmente (15 segundos)" TextWrapping="Wrap"/></CheckBox>
        <CheckBox Content="Apagar únicamente los monitores" IsChecked="{Binding ManualTurnOffMonitors, Mode=TwoWay}"/>
        <CheckBox Content="Bloquear sesión de Windows" IsChecked="{Binding ManualLockSession, Mode=TwoWay}"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </Border>
   </Grid>
   <Border Classes="card">
    <StackPanel Spacing="8">
     <TextBlock Classes="heading" Text="ANTES DE EJECUTAR"/>
     <WrapPanel>
      <CheckBox IsChecked="{Binding ManualGracePeriodEnabled, Mode=TwoWay}" Margin="0,0,12,0"><TextBlock Text="Mostrar una cuenta atrás antes de ejecutar" TextWrapping="Wrap"/></CheckBox>
      <NumericUpDown Name="ManualGraceInput" IsVisible="{Binding ManualGracePeriodEnabled}" Value="{Binding ManualGraceSeconds, Mode=TwoWay}" Minimum="1" Maximum="300" FormatString="0' s'" Width="115"/>
     </WrapPanel>
     <TextBlock Classes="hint" Text="El aviso comienza al cumplirse la condición. Durante el aviso puedes cancelar o posponer 10 minutos."/>
     <CheckBox Content="Tomar captura de pantalla antes de las acciones" IsChecked="{Binding ManualScreenshotEnabled, Mode=TwoWay}"/>
     <TextBlock Classes="hint" IsVisible="{Binding ManualScreenshotEnabled}" Text="{Binding ManualScreenshotStatus}"/>
     <CheckBox IsVisible="{Binding IsManualForcedCloseAvailable}" IsChecked="{Binding ManualForceClose, Mode=TwoWay}"><TextBlock Text="Permitir cierre forzado durante el apagado o reinicio" TextWrapping="Wrap"/></CheckBox>
     <TextBlock IsVisible="{Binding IsManualForcedCloseAvailable}" Classes="hint" Text="El cierre forzado puede perder cambios sin guardar. No elimina el aviso previo ni fuerza el cierre de los objetivos seleccionados."/>
    </StackPanel>
   </Border>
   <views:ActiveTasksView MaxHeight="270"/>
  </StackPanel>
 </ScrollViewer>
   <Border Classes="card" Grid.Row="1" Margin="20,0,20,14">
    <StackPanel Spacing="10">
     <TextBlock Classes="heading" Text="3 · RESUMEN Y ACTIVACIÓN"/>
     <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><TextBlock Name="ManualTaskSummary" Text="{Binding ManualSummaryText}" TextWrapping="Wrap"/></ScrollViewer>
     <TextBlock Text="{Binding ManualActivationWarning}" Foreground="{DynamicResource ThemeAccentWarning}" TextWrapping="Wrap"/>
     <WrapPanel>
      <Button Name="VerifyManualTaskButton" Content="Comprobar tarea" Command="{Binding VerifyManualTaskCommand}" Margin="0,0,10,6"/>
      <Button Name="StartManualTaskButton" Content="{Binding ManualStartButtonText}" Command="{Binding StartManualTaskCommand}" IsEnabled="{Binding CanStartManualTask}" Background="{DynamicResource ThemeAccentSuccess}" Foreground="#0E1015" FontWeight="Bold" Padding="18,10" Margin="0,0,0,6"/>
     </WrapPanel>
    </StackPanel>
   </Border>
 </Grid>
</UserControl>
