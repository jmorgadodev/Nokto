<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nokto.UI.Controls"
        x:Class="Nokto.UI.Views.IslandWindow"
        Title="Nokto Island" Width="116" Height="48" MinWidth="0" MinHeight="0"
        CanResize="False" SystemDecorations="None" ShowInTaskbar="False"
        Topmost="True" Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <Border x:Name="IslandSurface" Background="#090D15" BorderBrush="#314254"
          BorderThickness="1" CornerRadius="0,0,22,22" Padding="12,6"
          ClipToBounds="True" PointerPressed="OnSurfacePressed"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">
    <StackPanel Spacing="7">
      <Grid ColumnDefinitions="*,Auto" MinHeight="34">
        <controls:NoktoEyesControl x:Name="EyesVisual" Width="74" Height="34"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   AutomationProperties.Name="Ojos de Nokto"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock x:Name="ClockText" Text="--:--" IsVisible="False"
                     Foreground="#E6F0F8" FontFamily="Consolas" FontWeight="Medium"
                     FontSize="16" VerticalAlignment="Center" Margin="8,0,1,0"/>
          <TextBlock x:Name="CompactProductivityText" IsVisible="False" MaxWidth="100" FontSize="11"
                     Foreground="#FFD29B" FontFamily="Consolas" VerticalAlignment="Center"/>
          <TextBlock x:Name="CompactTrackText" IsVisible="False" MaxWidth="152"
                     FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     Foreground="#8AF1E2" Margin="5,0,0,0"/>
        </StackPanel>
      </Grid>
      <StackPanel x:Name="ExpandedTools" IsVisible="False" Opacity="0" Spacing="8">
        <Border Height="1" Background="#2D4053"/>
        <StackPanel x:Name="MediaPanel" IsVisible="False" Spacing="5"
                    AutomationProperties.AutomationId="IslandMediaPanel">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Border x:Name="MediaCoverFrame" Width="44" Height="44" IsVisible="False"
                    CornerRadius="6" ClipToBounds="True" Background="#172535">
              <Image x:Name="MediaCover" Stretch="UniformToFill" Width="44" Height="44"/>
            </Border>
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock x:Name="MediaTitle" FontSize="13" FontWeight="SemiBold"
                         Foreground="#E8F7FF" TextTrimming="CharacterEllipsis" MaxWidth="234"/>
              <TextBlock x:Name="MediaArtist" FontSize="11" Foreground="#99AFC1"
                         TextTrimming="CharacterEllipsis" MaxWidth="234"/>
            </StackPanel>
          </StackPanel>
          <ProgressBar x:Name="MediaProgress" Minimum="0" Maximum="100" Value="0"
                       Height="3" Background="#263747" Foreground="#72EBD2"/>
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button x:Name="MediaPreviousButton" Content="⏮" Click="OnMediaPrevious"
                    Background="#213747" Foreground="#E8FAFC" Padding="12,4"
                    AutomationProperties.AutomationId="IslandMediaPrevious"/>
            <Button x:Name="MediaPlayPauseButton" Content="⏯" Click="OnMediaToggle"
                    Background="#1C4A4F" Foreground="#F0FAFF" Padding="14,4"
                    AutomationProperties.AutomationId="IslandMediaPlayPause"/>
            <Button x:Name="MediaNextButton" Content="⏭" Click="OnMediaNext"
                    Background="#213747" Foreground="#E8FAFC" Padding="12,4"
                    AutomationProperties.AutomationId="IslandMediaNext"/>
            <TextBlock x:Name="MediaTime" Foreground="#B8CBDA" FontFamily="Consolas"
                       FontSize="10" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="ProductivityPanel" IsVisible="True" Spacing="6">
          <Button x:Name="ProductivityToggleButton" Content="⏱  Productividad" Click="OnToggleProductivity"
                  HorizontalAlignment="Stretch" Background="#192F3B" Foreground="#C3F3E8"
                  Padding="10,5" AutomationProperties.AutomationId="IslandProductivityToggle"/>
          <Border x:Name="ProductivityAlertFrame" IsVisible="False" Background="#42321E"
                  CornerRadius="7" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="ProductivityAlertText" Foreground="#FFE4AE" FontWeight="SemiBold"
                         Width="220" TextTrimming="CharacterEllipsis"/>
              <Button Content="✓" Click="OnDismissProductivityAlert" Padding="6,2"
                      AutomationProperties.AutomationId="IslandDismissAlert"/>
            </StackPanel>
          </Border>
          <StackPanel x:Name="ProductivityDetails" IsVisible="False" Spacing="7">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="Cuenta atrás" Foreground="#9DDBD8" VerticalAlignment="Center" Width="100"/>
              <TextBlock Text="{Binding IslandVm.Productivity.TimerText}" FontFamily="Consolas"
                         Foreground="#E9F7FF" VerticalAlignment="Center"/>
              <Button Content="5m" Click="OnTimer5" Padding="8,3" Margin="8,0,0,0"
                      AutomationProperties.AutomationId="IslandTimer5"/>
              <Button Content="15m" Click="OnTimer15" Padding="8,3"/>
              <Button Content="25m" Click="OnTimer25" Padding="8,3"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="{Binding IslandVm.Productivity.TimerAction}" Click="OnTimerToggle" Padding="10,3"/>
              <Button Content="Reiniciar" Click="OnTimerReset" Padding="10,3"/>
              <TextBlock Text="Cronómetro" Foreground="#9DDBD8" VerticalAlignment="Center" Margin="12,0,0,0"/>
              <TextBlock Text="{Binding IslandVm.Productivity.StopwatchText}" FontFamily="Consolas"
                         Foreground="#E9F7FF" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="{Binding IslandVm.Productivity.StopwatchAction}" Click="OnStopwatchToggle"
                      Padding="10,3" AutomationProperties.AutomationId="IslandStopwatch"/>
              <Button Content="Reiniciar crono" Click="OnStopwatchReset" Padding="10,3"/>
            </StackPanel>
            <Border Height="1" Background="#284558"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Pomodoro" Foreground="#9DDBD8" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding IslandVm.Productivity.PomodoroPhase}" Foreground="#D8EDFA"
                         VerticalAlignment="Center"/>
              <TextBlock Text="{Binding IslandVm.Productivity.PomodoroText}" Foreground="#E9F7FF"
                         FontFamily="Consolas" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="{Binding IslandVm.Productivity.PomodoroAction}" Click="OnPomodoroToggle"
                      Padding="10,3" AutomationProperties.AutomationId="IslandPomodoro"/>
              <Button Content="Reiniciar" Click="OnPomodoroReset" Padding="10,3"/>
            </StackPanel>
            <Border Height="1" Background="#284558"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Alarma" Foreground="#9DDBD8" VerticalAlignment="Center"/>
              <TextBox x:Name="AlarmTimeInput" Width="65" Watermark="HH:mm"
                       AutomationProperties.AutomationId="IslandAlarmTime"/>
              <CheckBox x:Name="AlarmDailyCheck" Content="Diaria" Foreground="#BFD4E1"
                        VerticalAlignment="Center"/>
              <Button Content="Añadir" Click="OnAddAlarm" Padding="9,3"
                      AutomationProperties.AutomationId="IslandAddAlarm"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding IslandVm.Productivity.NextAlarm}" Foreground="#DDEBFA"
                         FontSize="11" TextTrimming="CharacterEllipsis" Width="190" VerticalAlignment="Center"/>
              <Button Content="Eliminar alarma" Click="OnDeleteAlarm" FontSize="10" Padding="7,3"/>
            </StackPanel>
            <Border Height="1" Background="#284558"/>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBox x:Name="TaskInput" Width="119" Watermark="Nueva tarea..."
                       AutomationProperties.AutomationId="IslandTaskInput"/>
              <ComboBox x:Name="TaskReminderChoice" SelectedIndex="0" Width="105">
                <ComboBoxItem Content="Sin aviso"/>
                <ComboBoxItem Content="15 min"/>
                <ComboBoxItem Content="1 hora"/>
              </ComboBox>
              <Button Content="Añadir" Click="OnAddTask" Padding="8,3"
                      AutomationProperties.AutomationId="IslandAddTask"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding IslandVm.Productivity.NextTask}" Foreground="#DDEBFA"
                         FontSize="11" TextTrimming="CharacterEllipsis" Width="218" VerticalAlignment="Center"/>
              <Button Content="✓ Hecha" Click="OnCompleteTask" Padding="8,3"/>
            </StackPanel>
            <TextBlock x:Name="ProductivityValidationText" IsVisible="False"
                       Foreground="#FFB884" FontSize="10" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="SystemStatus" Spacing="2">
          <TextBlock x:Name="BatteryStatusText" Text="{Binding BatteryAndPowerText}"
                     TextTrimming="CharacterEllipsis" MaxWidth="290" Foreground="#9AB0C2" FontSize="11"/>
          <TextBlock x:Name="NetworkStatusText" Text="{Binding NetworkInterfaceText}"
                     TextTrimming="CharacterEllipsis" MaxWidth="290" Foreground="#9AB0C2" FontSize="11"
                     IsVisible="False"/>
        </StackPanel>
        <StackPanel x:Name="AudioControls" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Button Content="{Binding InputMuteButtonText}" Command="{Binding ToggleInputMuteCommand}"
                    FontSize="11" MinWidth="125" MaxWidth="147" Padding="7,5"
                    Foreground="#E8F3FF" Background="#1B3042" CornerRadius="7"/>
            <Button Content="{Binding OutputMuteButtonText}" Command="{Binding ToggleOutputMuteCommand}"
                    FontSize="11" MinWidth="125" MaxWidth="147" Padding="7,5"
                    Foreground="#E8F3FF" Background="#1B3042" CornerRadius="7"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
            <Button Content="−" Click="OnVolumeDown" FontSize="16" Padding="12,2"
                    Background="#1B3042" Foreground="#DDECF8" CornerRadius="7"/>
            <TextBlock Text="{Binding MasterVolumeText}" VerticalAlignment="Center"
                       Foreground="#B8CBDD" FontSize="12" MinWidth="45" TextAlignment="Center"/>
            <Button Content="+" Click="OnVolumeUp" FontSize="16" Padding="12,2"
                    Background="#1B3042" Foreground="#DDECF8" CornerRadius="7"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
          <Button x:Name="TestEyesButton" Content="{DynamicResource IslandTestEyes}" Click="OnTestEyes" Background="#263B4C" Foreground="#9CF9F0" Padding="9,5" CornerRadius="7"/>
          <Button Content="{DynamicResource IslandOpenDashboard}" Click="OnOpenDashboard" Background="#243E51"
                  Foreground="#F3FBFF" Padding="15,5" CornerRadius="7"/>
          <Button Content="{DynamicResource IslandHideIsland}" Click="OnHideIsland" Background="#222B38"
                  Foreground="#C9D5DF" Padding="15,5" CornerRadius="7"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>