<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nokto.UI.Controls"
        x:Class="Nokto.UI.Views.IslandWindow"
        Title="Nokto Island" Width="116" Height="48" MinWidth="0" MinHeight="0"
        CanResize="False" SystemDecorations="None" ShowInTaskbar="False"
        Topmost="True" Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <Grid x:Name="IslandScaleHost" ClipToBounds="True">
    <Border x:Name="IslandSurface" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="#090D15" BorderBrush="#314254" BorderThickness="1"
            CornerRadius="0,0,22,22" Padding="12,6" ClipToBounds="True"
            PointerPressed="OnSurfacePressed" PointerEntered="OnPointerEntered"
            PointerExited="OnPointerExited" PointerWheelChanged="OnIslandWheel">
      <StackPanel Spacing="7">
        <Grid x:Name="IslandHeader" ColumnDefinitions="*,Auto" MinHeight="34">
          <controls:NoktoEyesControl x:Name="EyesVisual" Width="74" Height="34"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     AutomationProperties.Name="Ojos de Nokto"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock x:Name="ClockText" Text="--:--" IsVisible="False"
                       Foreground="#E6F0F8" FontFamily="Consolas" FontWeight="Medium"
                       FontSize="16" VerticalAlignment="Center" Margin="8,0,1,0"/>
            <TextBlock x:Name="CompactProductivityText" IsVisible="False" MaxWidth="100" FontSize="11"
                       Foreground="#FFD29B" FontFamily="Consolas" VerticalAlignment="Center"/>
            <TextBlock x:Name="CompactTrackText" IsVisible="False" MaxWidth="152"
                       FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Foreground="#8AF1E2" Margin="5,0,0,0"/>
          </StackPanel>
        </Grid>

        <StackPanel x:Name="ExpandedTools" IsVisible="False" Opacity="0" Spacing="8">
          <Border Height="1" Background="#2D4053"/>
          <Grid ColumnDefinitions="36,*,36">
            <Button Grid.Column="0" Content="‹" Click="OnPagePrevious"
                    AutomationProperties.AutomationId="IslandPagePrevious"
                    Background="#182635" Foreground="#A4D8E1" Padding="6,3" CornerRadius="8"/>
            <TextBlock x:Name="PageTitle" Grid.Column="1" AutomationProperties.AutomationId="IslandPageTitle" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="#95EBDF" FontSize="12" FontWeight="SemiBold"/>
            <Button Grid.Column="2" Content="›" Click="OnPageNext"
                    AutomationProperties.AutomationId="IslandPageNext"
                    Background="#182635" Foreground="#A4D8E1" Padding="6,3" CornerRadius="8"/>
          </Grid>

          <StackPanel x:Name="OverviewPage" Spacing="8">
            <StackPanel x:Name="MediaPanel" IsVisible="False" Spacing="5"
                        AutomationProperties.AutomationId="IslandMediaPanel">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Border x:Name="MediaCoverFrame" Width="44" Height="44" IsVisible="False"
                        CornerRadius="6" ClipToBounds="True" Background="#172535">
                  <Image x:Name="MediaCover" Stretch="UniformToFill" Width="44" Height="44"/>
                </Border>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock x:Name="MediaTitle" FontSize="13" FontWeight="SemiBold"
                             Foreground="#E8F7FF" TextTrimming="CharacterEllipsis" MaxWidth="234"/>
                  <TextBlock x:Name="MediaArtist" FontSize="11" Foreground="#99AFC1"
                             TextTrimming="CharacterEllipsis" MaxWidth="234"/>
                </StackPanel>
              </StackPanel>
              <ProgressBar x:Name="MediaProgress" Minimum="0" Maximum="100" Value="0"
                           Height="3" Background="#263747" Foreground="#72EBD2"/>
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button x:Name="MediaPreviousButton" Content="⏮" Click="OnMediaPrevious"
                        Background="#213747" Foreground="#E8FAFC" Padding="12,4"
                        AutomationProperties.AutomationId="IslandMediaPrevious"/>
                <Button x:Name="MediaPlayPauseButton" Content="⏯" Click="OnMediaToggle"
                        Background="#1C4A4F" Foreground="#F0FAFF" Padding="14,4"
                        AutomationProperties.AutomationId="IslandMediaPlayPause"/>
                <Button x:Name="MediaNextButton" Content="⏭" Click="OnMediaNext"
                        Background="#213747" Foreground="#E8FAFC" Padding="12,4"
                        AutomationProperties.AutomationId="IslandMediaNext"/>
                <TextBlock x:Name="MediaTime" Foreground="#B8CBDA" FontFamily="Consolas"
                           FontSize="10" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="SystemStatus" Spacing="3">
              <TextBlock x:Name="BatteryStatusText" Text="{Binding BatteryAndPowerText}"
                         TextTrimming="CharacterEllipsis" MaxWidth="292"
                         Foreground="#9AB0C2" FontSize="11"/>
              <TextBlock x:Name="NetworkStatusText" Text="{Binding NetworkInterfaceText}"
                         TextTrimming="CharacterEllipsis" MaxWidth="292"
                         Foreground="#9AB0C2" FontSize="11" IsVisible="False"/>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="AudioPage" IsVisible="False" Spacing="10">
            <StackPanel x:Name="AudioControls" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Button Content="{Binding InputMuteButtonText}" Command="{Binding ToggleInputMuteCommand}"
                        FontSize="11" MinWidth="125" MaxWidth="147" Padding="7,6"
                        Foreground="#E8F3FF" Background="#1B3042" CornerRadius="7"/>
                <Button Content="{Binding OutputMuteButtonText}" Command="{Binding ToggleOutputMuteCommand}"
                        FontSize="11" MinWidth="125" MaxWidth="147" Padding="7,6"
                        Foreground="#E8F3FF" Background="#1B3042" CornerRadius="7"/>
              </StackPanel>
              <Grid ColumnDefinitions="32,*,32">
                <Button Grid.Column="0" Content="−" Click="OnVolumeDown" FontSize="16"
                        Padding="6,3" Background="#1B3042" Foreground="#DDECF8"/>
                <Slider Grid.Column="1" Margin="8,0" Minimum="0" Maximum="100"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding MasterVolumePercent, Mode=TwoWay}"
                        AutomationProperties.AutomationId="IslandVolumeSlider"/>
                <Button Grid.Column="2" Content="+" Click="OnVolumeUp" FontSize="16"
                        Padding="6,3" Background="#1B3042" Foreground="#DDECF8"/>
              </Grid>
              <TextBlock Text="{Binding MasterVolumeText}" TextAlignment="Center"
                         Foreground="#B8CBDD" FontFamily="Consolas" FontSize="12"/>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="QuickPage" IsVisible="False" Spacing="8">
            <StackPanel x:Name="ProductivityPanel" IsVisible="True" Spacing="5">
              <Button x:Name="ProductivityToggleButton" Content="{DynamicResource IslandOpenRoutines}"
                      Click="OnOpenRoutinesIsland" Background="#1A3A44" Foreground="#B8F4E7"
                      Padding="10,6" AutomationProperties.AutomationId="IslandRoutinesButton"/>
              <Border x:Name="ProductivityAlertFrame" IsVisible="False" Background="#42321E"
                      CornerRadius="7" Padding="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock x:Name="ProductivityAlertText" Foreground="#FFE4AE"
                             FontWeight="SemiBold" Width="220" TextTrimming="CharacterEllipsis"/>
                  <Button Content="✓" Click="OnDismissProductivityAlert" Padding="6,2"
                          AutomationProperties.AutomationId="IslandDismissAlert"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="QuickActionsPanel" IsVisible="True" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{DynamicResource IslandExplorer}" Click="OnOpenExplorer"
                        AutomationProperties.AutomationId="IslandOpenExplorer"
                        Padding="9,5" Background="#233F4E" Foreground="#EFFCFF"/>
                <Button Content="{DynamicResource IslandChooseFolder}" Click="OnAddFolder"
                        AutomationProperties.AutomationId="IslandAddFolder"
                        Padding="9,5" Background="#203B46" Foreground="#B3F3EB"/>
              </StackPanel>
              <TextBlock Text="{Binding IslandVm.QuickFoldersLabel}" Foreground="#9BBED0" FontSize="11"/>
              <ListBox x:Name="QuickFolderList" MaxHeight="80" MinHeight="32"
                       ItemsSource="{Binding IslandVm.QuickFolders}"
                       AutomationProperties.AutomationId="IslandFolderList">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                               MaxWidth="265" Foreground="#DDECF5"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="{DynamicResource IslandOpenFolder}" Click="OnOpenFolder"
                        AutomationProperties.AutomationId="IslandOpenFolder"
                        FontSize="11" Padding="8,4"/>
                <Button Content="{DynamicResource IslandRemoveFolder}" Click="OnRemoveFolder"
                        AutomationProperties.AutomationId="IslandRemoveFolder"
                        FontSize="11" Padding="8,4"/>
              </StackPanel>
              <TextBlock x:Name="QuickFolderStatus" FontSize="10" Foreground="#BED5E0"
                         TextWrapping="Wrap" MaxWidth="290"/>
            </StackPanel>

            <StackPanel x:Name="FileShelfPanel" IsVisible="False" Spacing="6">
              <Button Content="{Binding IslandVm.ShelfLabel}" Click="OnToggleShelf"
                      AutomationProperties.AutomationId="IslandShelfToggle"
                      Background="#1C3445" Foreground="#A6E8E4" Padding="10,6"/>
              <StackPanel x:Name="ShelfDetails" Spacing="6" IsVisible="False">
                <Button Content="＋ Elegir archivo local" Click="OnShelfPick"
                        AutomationProperties.AutomationId="IslandShelfPick"
                        Background="#274958" Foreground="#F0F7FE" Padding="8,5"/>
                <ListBox x:Name="ShelfList" Height="95" ItemsSource="{Binding IslandVm.ShelfFiles}"
                         AutomationProperties.AutomationId="IslandShelfList">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" Foreground="#D8EDFA"
                                 TextTrimming="CharacterEllipsis" MaxWidth="275"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="Abrir seleccionado" Click="OnShelfOpen"
                          AutomationProperties.AutomationId="IslandShelfOpen" Padding="9,4"/>
                  <Button Content="Quitar de la lista" Click="OnShelfRemove"
                          AutomationProperties.AutomationId="IslandShelfRemove" Padding="9,4"/>
                </StackPanel>
                <TextBlock x:Name="ShelfStatusText" FontSize="10" Foreground="#B8CDD9"
                           MaxWidth="292" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="ClipboardPanel" IsVisible="False" Spacing="5">
              <Button Content="{DynamicResource IslandClipboardRead}" Click="OnReadClipboard"
                      AutomationProperties.AutomationId="IslandClipboardRead"
                      Padding="8,5" Background="#20303B" Foreground="#C3E7ED"/>
              <TextBlock x:Name="ClipboardPreview" FontSize="10" Foreground="#B4D5DB"
                         TextTrimming="CharacterEllipsis" MaxWidth="280"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
            <Button x:Name="TestEyesButton" Content="{DynamicResource IslandTestEyes}"
                    Click="OnTestEyes" Background="#263B4C" Foreground="#9CF9F0"
                    Padding="9,5" CornerRadius="7"/>
            <Button Content="{DynamicResource IslandOpenDashboard}" Click="OnOpenDashboard"
                    Background="#243E51" Foreground="#F3FBFF" Padding="15,5" CornerRadius="7"/>
            <Button Content="{DynamicResource IslandHideIsland}" Click="OnHideIsland"
                    Background="#222B38" Foreground="#C9D5DF" Padding="15,5" CornerRadius="7"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>