<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nokto.UI.ViewModels"
        x:Class="Nokto.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Nokto — Sistema Determinista de Energía"
        Width="880"
        Height="640"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Nokto/Assets/nokto.ico"
        Background="#0E0F12">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- TOP BAR / HEADER -->
        <Border Grid.Row="0" Background="#16181D" BorderBrush="#262930" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#1E222A" BorderBrush="#00D2FF" BorderThickness="1.5">
                        <TextBlock Text="◐" Foreground="#00D2FF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nokto" Foreground="#F0F2F5" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0" Foreground="#7D8390" FontSize="11" VerticalAlignment="Center" Margin="4,2,0,0"/>
                </StackPanel>

                <!-- Status Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#262930" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding StatusDotColor}"/>
                            <TextBlock Text="{Binding CurrentStatusText}"
                                       Foreground="#F0F2F5"
                                       FontSize="11"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY CONTENT CON PESTAÑAS (TABCONTROL) -->
        <TabControl Grid.Row="1" Background="Transparent" Margin="12,6,12,0">

            <!-- ======================================================== -->
            <!-- PESTAÑA 1: CONFIGURACIÓN MANUAL (VISTA PRINCIPAL)        -->
            <!-- ======================================================== -->
            <TabItem FontSize="12" FontWeight="SemiBold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconSliders}" Width="14" Height="14" Foreground="#00D2FF"/>
                        <TextBlock Text="Configuración Manual" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
                    <StackPanel Spacing="14">
                        <!-- GRID EN 2 COLUMNAS (DISPARADOR VS ACCIÓN) -->
                        <Grid ColumnDefinitions="*,18,*">

                            <!-- COLUMNA IZQUIERDA: ¿CUÁNDO EJECUTAR? (DISPARADOR) -->
                            <Border Grid.Column="0" Background="#16181D" BorderBrush="#262930" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconClock}" Width="14" Height="14" Foreground="#00D2FF"/>
                                        <TextBlock Text="¿CUÁNDO EJECUTAR? (DISPARADOR)" Foreground="#00D2FF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Selector de Tipo de Disparador -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Tipo de disparador:" Foreground="#7D8390" FontSize="11"/>
                                        <ComboBox SelectedIndex="{Binding SelectedTriggerTypeIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  Background="#0E0F12"
                                                  Foreground="#F0F2F5"
                                                  FontSize="12">
                                            <ComboBoxItem Content="Cuenta Atrás"/>
                                            <ComboBoxItem Content="Hora Exacta"/>
                                            <ComboBoxItem Content="Inactividad del Usuario"/>
                                            <ComboBoxItem Content="Al Terminar un Proceso"/>
                                            <ComboBoxItem Content="Silencio de Audio"/>
                                            <ComboBoxItem Content="Estado de Batería / AC"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- PANEL DINÁMICO 1: CUENTA ATRÁS -->
                                    <Border IsVisible="{Binding IsTriggerCountdown}" Background="#0E0F12" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Tiempo de espera:" Foreground="#7D8390" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedCountdownText}" Foreground="#00D2FF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- 3 CONTADORES ERGONÓMICOS: HORAS, MINUTOS, SEGUNDOS -->
                                            <Grid ColumnDefinitions="*,*,*">
                                                <!-- HORAS -->
                                                <Border Grid.Column="0" Background="#16181D" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,4,0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="HORAS" FontSize="10" FontWeight="Bold" Foreground="#7D8390" HorizontalAlignment="Center"/>
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Button Grid.Column="0" Content="−" Command="{Binding DecrementHoursCommand}"
                                                                    Width="28" Height="32" Padding="0"
                                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                    Background="#222630" Foreground="#F0F2F5" FontWeight="Bold" FontSize="14"
                                                                    ToolTip.Tip="Restar 1 hora"/>
                                                            
                                                            <NumericUpDown Grid.Column="1" Value="{Binding CountdownHours, Mode=TwoWay}"
                                                                           Minimum="0" Maximum="23" FormatString="00" Watermark="00"
                                                                           ShowButtonSpinner="False"
                                                                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                           TextAlignment="Center"
                                                                           FontSize="18" FontWeight="Bold" FontFamily="Consolas, monospace"
                                                                           Foreground="#00D2FF" Background="#0E0F12"
                                                                           BorderBrush="#262930" BorderThickness="1"
                                                                           CornerRadius="4" Height="32" Margin="4,0"/>

                                                            <Button Grid.Column="2" Content="+" Command="{Binding IncrementHoursCommand}"
                                                                    Width="28" Height="32" Padding="0"
                                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                    Background="#222630" Foreground="#F0F2F5" FontWeight="Bold" FontSize="14"
                                                                    ToolTip.Tip="Sumar 1 hora"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- MINUTOS -->
                                                <Border Grid.Column="1" Background="#16181D" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="6" Margin="2,0,2,0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="MINUTOS" FontSize="10" FontWeight="Bold" Foreground="#7D8390" HorizontalAlignment="Center"/>
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Button Grid.Column="0" Content="−" Command="{Binding DecrementMinutesCommand}"
                                                                    Width="28" Height="32" Padding="0"
                                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                    Background="#222630" Foreground="#F0F2F5" FontWeight="Bold" FontSize="14"
                                                                    ToolTip.Tip="Restar 1 minuto"/>
                                                            
                                                            <NumericUpDown Grid.Column="1" Value="{Binding CountdownMinutes, Mode=TwoWay}"
                                                                           Minimum="0" Maximum="59" FormatString="00" Watermark="00"
                                                                           ShowButtonSpinner="False"
                                                                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                           TextAlignment="Center"
                                                                           FontSize="18" FontWeight="Bold" FontFamily="Consolas, monospace"
                                                                           Foreground="#00D2FF" Background="#0E0F12"
                                                                           BorderBrush="#262930" BorderThickness="1"
                                                                           CornerRadius="4" Height="32" Margin="4,0"/>

                                                            <Button Grid.Column="2" Content="+" Command="{Binding IncrementMinutesCommand}"
                                                                    Width="28" Height="32" Padding="0"
                                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                    Background="#222630" Foreground="#F0F2F5" FontWeight="Bold" FontSize="14"
                                                                    ToolTip.Tip="Sumar 1 minuto"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- SEGUNDOS -->
                                                <Border Grid.Column="2" Background="#16181D" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="6" Margin="4,0,0,0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="SEGUNDOS" FontSize="10" FontWeight="Bold" Foreground="#7D8390" HorizontalAlignment="Center"/>
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Button Grid.Column="0" Content="−" Command="{Binding DecrementSecondsCommand}"
                                                                    Width="28" Height="32" Padding="0"
                                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                    Background="#222630" Foreground="#F0F2F5" FontWeight="Bold" FontSize="14"
                                                                    ToolTip.Tip="Restar 1 segundo"/>
                                                            
                                                            <NumericUpDown Grid.Column="1" Value="{Binding CountdownSeconds, Mode=TwoWay}"
                                                                           Minimum="0" Maximum="59" FormatString="00" Watermark="00"
                                                                           ShowButtonSpinner="False"
                                                                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                           TextAlignment="Center"
                                                                           FontSize="18" FontWeight="Bold" FontFamily="Consolas, monospace"
                                                                           Foreground="#00D2FF" Background="#0E0F12"
                                                                           BorderBrush="#262930" BorderThickness="1"
                                                                           CornerRadius="4" Height="32" Margin="4,0"/>

                                                            <Button Grid.Column="2" Content="+" Command="{Binding IncrementSecondsCommand}"
                                                                    Width="28" Height="32" Padding="0"
                                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                    Background="#222630" Foreground="#F0F2F5" FontWeight="Bold" FontSize="14"
                                                                    ToolTip.Tip="Sumar 1 segundo"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Botones rápidos de suma (Chips) -->
                                            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="Añadir:" Foreground="#7D8390" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Button Content="+5m" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="5" Background="#262930" Foreground="#F0F2F5" FontSize="10" Padding="8,4" Margin="2"/>
                                                <Button Content="+15m" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="15" Background="#262930" Foreground="#F0F2F5" FontSize="10" Padding="8,4" Margin="2"/>
                                                <Button Content="+30m" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="30" Background="#262930" Foreground="#F0F2F5" FontSize="10" Padding="8,4" Margin="2"/>
                                                <Button Content="+45m" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="45" Background="#262930" Foreground="#F0F2F5" FontSize="10" Padding="8,4" Margin="2"/>
                                                <Button Content="+1h" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="60" Background="#262930" Foreground="#F0F2F5" FontSize="10" Padding="8,4" Margin="2"/>
                                                <Button Content="+2h" Command="{Binding AddCountdownMinutesCommand}" CommandParameter="120" Background="#262930" Foreground="#F0F2F5" FontSize="10" Padding="8,4" Margin="2"/>
                                                <Button Content="Reset" Command="{Binding ResetCountdownCommand}" Background="#3A1C1C" Foreground="#FF6B6B" FontWeight="Bold" FontSize="10" Padding="8,4" Margin="6,2,2,2"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANEL DINÁMICO 2: HORA EXACTA -->
                                    <Border IsVisible="{Binding IsTriggerExactTime}" Background="#0E0F12" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Seleccionar hora de ejecución (reloj 24h):" Foreground="#7D8390" FontSize="11"/>
                                            <TimePicker SelectedTime="{Binding ExactTime, Mode=TwoWay}"
                                                        ClockIdentifier="24HourClock"
                                                        HorizontalAlignment="Stretch"
                                                        Background="#16181D"
                                                        Foreground="#F0F2F5"/>
                                            <TextBlock Text="{Binding ExactTimeSummaryText}" Foreground="#00D2FF" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANEL DINÁMICO 3: INACTIVIDAD DE PERIFÉRICOS -->
                                    <Border IsVisible="{Binding IsTriggerInactivity}" Background="#0E0F12" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Minutos continuos sin actividad de ratón ni teclado:" Foreground="#7D8390" FontSize="11"/>
                                            <NumericUpDown Value="{Binding InactivityMinutes, Mode=TwoWay}"
                                                           Minimum="1" Maximum="1440"
                                                           ShowButtonSpinner="False"
                                                           TextAlignment="Center" HorizontalContentAlignment="Center"
                                                           FontSize="16" FontWeight="Bold" FontFamily="Consolas, monospace"
                                                           Foreground="#00D2FF" Background="#16181D" Height="34"/>
                                            <TextBlock Text="Se ejecutará la acción tras este periodo de reposo absoluto." Foreground="#7D8390" FontSize="10"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANEL DINÁMICO 4: AL TERMINAR PROCESO -->
                                    <Border IsVisible="{Binding IsTriggerProcessExit}" Background="#0E0F12" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Seleccionar proceso a vigilar:" Foreground="#7D8390" FontSize="11" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Refrescar" Command="{Binding RefreshProcessesCommand}" Background="#262930" Foreground="#00D2FF" FontSize="10" Padding="6,2"/>
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding AvailableProcesses}"
                                                      SelectedItem="{Binding SelectedProcessName, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      Background="#16181D"
                                                      Foreground="#F0F2F5"
                                                      FontSize="11"/>
                                            <CheckBox IsChecked="{Binding EnableCpuThreshold, Mode=TwoWay}" Content="Esperar también que CPU baje de 5%" Foreground="#7D8390" FontSize="10"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANEL DINÁMICO 5: SILENCIO DE AUDIO -->
                                    <Border IsVisible="{Binding IsTriggerAudioSilence}" Background="#0E0F12" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Segundos continuos de silencio maestro (Peak &lt; 0.001):" Foreground="#7D8390" FontSize="11"/>
                                            <NumericUpDown Value="{Binding AudioSilenceSeconds, Mode=TwoWay}"
                                                           Minimum="1" Maximum="3600"
                                                           ShowButtonSpinner="False"
                                                           TextAlignment="Center" HorizontalContentAlignment="Center"
                                                           FontSize="16" FontWeight="Bold" FontFamily="Consolas, monospace"
                                                           Foreground="#00D2FF" Background="#16181D" Height="34"/>
                                            <TextBlock Text="Muestreo en tiempo real mediante WASAPI IAudioMeterInformation." Foreground="#7D8390" FontSize="10"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANEL DINÁMICO 6: ESTADO DE BATERÍA / AC -->
                                    <Border IsVisible="{Binding IsTriggerBatteryState}" Background="#0E0F12" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Condiciones de batería y alimentación AC:" Foreground="#7D8390" FontSize="11"/>
                                            <CheckBox IsChecked="{Binding BatteryTriggerOnAcDisconnect, Mode=TwoWay}"
                                                      Content="Activar al desconectar el cargador (Modo Batería)"
                                                      Foreground="#F0F2F5" FontSize="11"/>
                                            <CheckBox IsChecked="{Binding BatteryTriggerOnThreshold, Mode=TwoWay}"
                                                      Content="Activar si el nivel cae por debajo del umbral:"
                                                      Foreground="#F0F2F5" FontSize="11"/>
                                            <Grid ColumnDefinitions="Auto,*" Margin="20,0,0,0" IsVisible="{Binding BatteryTriggerOnThreshold}">
                                                <TextBlock Text="Porcentaje:" Foreground="#7D8390" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding BatteryThresholdPercent, Mode=TwoWay}"
                                                               Minimum="1" Maximum="100"
                                                               ShowButtonSpinner="False"
                                                               TextAlignment="Center" HorizontalContentAlignment="Center"
                                                               FontSize="16" FontWeight="Bold" FontFamily="Consolas, monospace"
                                                               Foreground="#00D2FF" Background="#16181D" Height="34"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- COLUMNA DERECHA: ¿QUÉ ACCIÓN REALIZAR? -->
                            <Border Grid.Column="2" Background="#16181D" BorderBrush="#262930" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconPower}" Width="14" Height="14" Foreground="#00D2FF"/>
                                        <TextBlock Text="¿QUÉ ACCIÓN REALIZAR?" Foreground="#00D2FF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- ComboBox de Acción Terminal con Iconografía Vectorial Fluent -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Acción terminal al activarse:" Foreground="#7D8390" FontSize="11"/>
                                        <ComboBox SelectedIndex="{Binding SelectedTerminalActionIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  Background="#0E0F12"
                                                  Foreground="#F0F2F5"
                                                  FontSize="12">
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource IconPower}" Width="13" Height="13" Foreground="#FF4B4B"/>
                                                    <TextBlock Text="Apagar el PC" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource IconMoon}" Width="13" Height="13" Foreground="#A0A5B0"/>
                                                    <TextBlock Text="Suspender" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource IconHibernate}" Width="13" Height="13" Foreground="#A0A5B0"/>
                                                    <TextBlock Text="Hibernar" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource IconRestart}" Width="13" Height="13" Foreground="#00D2FF"/>
                                                    <TextBlock Text="Reiniciar" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource IconLock}" Width="13" Height="13" Foreground="#FFB300"/>
                                                    <TextBlock Text="Bloquear Sesión" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                            <ComboBoxItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource IconMonitorOff}" Width="13" Height="13" Foreground="#00D2FF"/>
                                                    <TextBlock Text="Apagar Monitores" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Modificadores de la Acción -->
                                    <Border Background="#0E0F12" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Modificadores y seguridad:" Foreground="#7D8390" FontSize="11"/>
                                            <CheckBox IsChecked="{Binding OptForceClose, Mode=TwoWay}"
                                                      Content="Forzar cierre inmediato (sin apps colgadas)"
                                                      Foreground="#F0F2F5" FontSize="11"/>
                                            <CheckBox IsChecked="{Binding OptAudioFadeOut, Mode=TwoWay}"
                                                      Content="Desvanecimiento progresivo WASAPI"
                                                      Foreground="#F0F2F5" FontSize="11"/>
                                            <CheckBox IsChecked="{Binding OptGracePeriod, Mode=TwoWay}"
                                                      Content="Aviso flotante previo de gracia (60s)"
                                                      Foreground="#F0F2F5" FontSize="11"/>
                                            <CheckBox IsChecked="{Binding OptScreenshot, Mode=TwoWay}"
                                                      Content="Tomar captura de pantalla de evidencia"
                                                      Foreground="#F0F2F5" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ZONA INFERIOR: ACCIÓN DESTACADA / PANEL DE TAREA ACTIVA -->
                        <Border Background="#16181D" BorderBrush="#262930" BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <Grid>
                                <!-- ESTADO 1: EN ESPERA -> BOTÓN INICIAR TAREA -->
                                <StackPanel IsVisible="{Binding !IsTaskRunning}">
                                    <Button Background="#00E676"
                                            Foreground="#0E0F12"
                                            FontWeight="Bold"
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Height="44"
                                            Command="{Binding StartManualTaskCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource IconPlay}" Width="13" Height="13" Foreground="#0E0F12"/>
                                            <TextBlock Text="INICIAR TAREA" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- ESTADO 2: TAREA ACTIVA -> TIEMPO RESTANTE + PROGRESO + CANCELAR -->
                                <Grid IsVisible="{Binding IsTaskRunning}" RowDefinitions="Auto,Auto,Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding ActiveTaskTitle}" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding CurrentStatusText}" Foreground="#7D8390" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TimeRemainingText}"
                                                   Foreground="#F0F2F5"
                                                   FontWeight="Bold"
                                                   FontSize="20"
                                                   FontFamily="Consolas, monospace"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="1"
                                                 Height="5"
                                                 Margin="0,8,0,8"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercentage}"
                                                 Foreground="#00D2FF"
                                                 Background="#262930"/>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
                                        <Button Grid.Column="0"
                                                Background="#262930"
                                                Foreground="#F0F2F5"
                                                FontSize="11"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding PostponeTaskCommand}"
                                                CommandParameter="10">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource IconClock}" Width="11" Height="11" Foreground="#00D2FF"/>
                                                <TextBlock Text="+10 Min" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Background="#FF4B4B"
                                                Foreground="#FFFFFF"
                                                FontWeight="Bold"
                                                FontSize="11"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding AbortTaskCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource IconStop}" Width="11" Height="11" Foreground="#FFFFFF"/>
                                                <TextBlock Text="CANCELAR / ABORTAR" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================== -->
            <!-- PESTAÑA 2: ACCESOS RÁPIDOS (4 TARJETAS OPERATIVAS)       -->
            <!-- ======================================================== -->
            <TabItem FontSize="12" FontWeight="SemiBold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconLightning}" Width="14" Height="14" Foreground="#00D2FF"/>
                        <TextBlock Text="Accesos Rápidos" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
                    <StackPanel Spacing="12">
                        <!-- BANNER TAREA EN CURSO (SI ESTÁ ACTIVA) -->
                        <Border IsVisible="{Binding IsTaskRunning}"
                                Background="#16181D"
                                BorderBrush="#00D2FF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding ActiveTaskTitle}" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Tiempo restante para acción terminal:" Foreground="#7D8390" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TimeRemainingText}"
                                               Foreground="#F0F2F5"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               FontFamily="Consolas, monospace"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar Grid.Row="1"
                                             Height="4"
                                             Margin="0,8,0,8"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercentage}"
                                             Foreground="#00D2FF"
                                             Background="#262930"/>
                                <Grid Grid.Row="2" ColumnDefinitions="*,10,*">
                                    <Button Grid.Column="0"
                                            Background="#262930"
                                            Foreground="#F0F2F5"
                                            FontSize="11"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding PostponeTaskCommand}"
                                            CommandParameter="10">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource IconClock}" Width="11" Height="11" Foreground="#00D2FF"/>
                                            <TextBlock Text="+10 Min" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Background="#FF4B4B"
                                            Foreground="#FFFFFF"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding AbortTaskCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource IconStop}" Width="11" Height="11" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Abortar Tarea" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- GRID 2x2 DE TARJETAS FUNCIONALES -->
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,14,*">
                            <!-- TARJETA 1: MODO TRABAJO (KEEP-ALIVE) -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="#16181D"
                                    BorderBrush="#262930"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconLightning}" Width="14" Height="14" Foreground="#00E676" VerticalAlignment="Center"/>
                                        <TextBlock Text="MODO TRABAJO" Foreground="#F0F2F5" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Mantener activo en Teams / Slack (Jitter F15 + Mouse)."
                                               Foreground="#7D8390"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Height="32"/>
                                    <Button Content="{Binding KeepAliveButtonText}"
                                            Background="#262930"
                                            Foreground="#00E676"
                                            FontWeight="Bold"
                                            FontSize="11"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding ToggleKeepAliveCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- TARJETA 2: MODO DORMIR -->
                            <Border Grid.Row="0" Grid.Column="2"
                                    Background="#16181D"
                                    BorderBrush="#262930"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconMoon}" Width="14" Height="14" Foreground="#00D2FF" VerticalAlignment="Center"/>
                                        <TextBlock Text="MODO DORMIR" Foreground="#F0F2F5" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Apagar en 45 min con fade out progresivo de audio."
                                               Foreground="#7D8390"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Height="32"/>
                                    <Button Content="Iniciar Reposo"
                                            Background="#262930"
                                            Foreground="#F0F2F5"
                                            FontSize="11"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding StartSleepModeCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- TARJETA 3: FIN DE TAREA -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    Background="#16181D"
                                    BorderBrush="#262930"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconClock}" Width="14" Height="14" Foreground="#00D2FF" VerticalAlignment="Center"/>
                                        <TextBlock Text="FIN DE TAREA" Foreground="#F0F2F5" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding AvailableProcesses}"
                                              SelectedItem="{Binding SelectedProcessName}"
                                              HorizontalAlignment="Stretch"
                                              FontSize="11"
                                              Background="#0E0F12"
                                              Foreground="#F0F2F5"/>
                                    <Button Content="Vigilar y Apagar"
                                            Background="#262930"
                                            Foreground="#F0F2F5"
                                            FontSize="11"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding StartProcessWatchCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- TARJETA 4: APAGADO RÁPIDO -->
                            <Border Grid.Row="1" Grid.Column="2"
                                    Background="#16181D"
                                    BorderBrush="#262930"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconPower}" Width="14" Height="14" Foreground="#FF4B4B" VerticalAlignment="Center"/>
                                        <TextBlock Text="APAGADO RÁPIDO" Foreground="#F0F2F5" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*,*">
                                        <Button Grid.Column="0" Content="30m"
                                                Background="#262930" Foreground="#F0F2F5" FontSize="10"
                                                Padding="4,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Command="{Binding StartQuickShutdownCommand}" CommandParameter="30" Margin="0,0,2,0"/>
                                        <Button Grid.Column="1" Content="1h"
                                                Background="#262930" Foreground="#F0F2F5" FontSize="10"
                                                Padding="4,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Command="{Binding StartQuickShutdownCommand}" CommandParameter="60" Margin="2,0,2,0"/>
                                        <Button Grid.Column="2" Content="2h"
                                                Background="#262930" Foreground="#F0F2F5" FontSize="10"
                                                Padding="4,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Command="{Binding StartQuickShutdownCommand}" CommandParameter="120" Margin="2,0,0,0"/>
                                    </Grid>
                                    <Button Content="Apagar Monitores"
                                            Background="#262930"
                                            Foreground="#00D2FF"
                                            FontSize="11"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding TurnOffMonitorsNowCommand}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================================== -->
            <!-- PESTAÑA 3: MODO STUDIO (EDITOR DE PIPELINES Y PRESETS)   -->
            <!-- ======================================================== -->
            <TabItem FontSize="12" FontWeight="SemiBold">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconWorkflow}" Width="14" Height="14" Foreground="#00D2FF"/>
                        <TextBlock Text="Modo Studio" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
                    <Grid ColumnDefinitions="240,*" Margin="0,4,0,4">
                        <!-- PANEL IZQUIERDO: PRESETS -->
                        <Border Grid.Column="0" Background="#16181D" BorderBrush="#262930" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,14,0">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
                                    <PathIcon Data="{StaticResource IconWorkflow}" Width="12" Height="12" Foreground="#00D2FF" VerticalAlignment="Center"/>
                                    <TextBlock Text="PRESETS GUARDADOS" Foreground="#F0F2F5" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Background="Transparent" Foreground="#F0F2F5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2" Margin="0,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#7D8390" FontSize="10" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="2" Content="+ Nuevo Flujo" Command="{Binding AddNewPresetCommand}" Background="#262930" Foreground="#F0F2F5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <!-- PANEL DERECHO: EDITOR SECUENCIAL DE PIPELINE -->
                        <Border Grid.Column="1" Background="#16181D" BorderBrush="#262930" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconSliders}" Width="13" Height="13" Foreground="#00D2FF" VerticalAlignment="Center"/>
                                    <TextBlock Text="EDITOR DE PIPELINE DETERMINISTA" Foreground="#00D2FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- BLOQUE 1: DISPARADOR -->
                                <Border Background="#0E0F12" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="[BLOQUE 1: DISPARADOR PRINCIPAL]" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="Tipo: Monitoreo de Proceso Activo" Foreground="#F0F2F5" FontSize="12"/>
                                        <TextBlock Text="Condición: Esperar salida o umbral CPU configurado." Foreground="#7D8390" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- BLOQUE 2: ACCIÓN INTERMEDIA -->
                                <Border Background="#0E0F12" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="[BLOQUE 2: ACCIÓN INTERMEDIA]" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="Tipo: Captura de Pantalla + Desvanecimiento de Audio" Foreground="#F0F2F5" FontSize="12"/>
                                        <TextBlock Text="Destino: ./data/snapshots/ (Sellado de fecha y hora)" Foreground="#7D8390" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- BLOQUE 3: ACCIÓN TERMINAL -->
                                <Border Background="#0E0F12" BorderBrush="#262930" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="[BLOQUE 3: ACCIÓN TERMINAL]" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="Tipo: Apagado Seguro de Sistema" Foreground="#F0F2F5" FontSize="12"/>
                                        <TextBlock Text="Periodo de gracia: 60s con ventana de aviso flotante." Foreground="#7D8390" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="Guardar Modificaciones de Pipeline" Command="{Binding SavePresetCommand}" Background="#00D2FF" Foreground="#0E0F12" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- FOOTER BAR / HARDWARE MONITOR (VECTORIAL, SIN STRING 'TRUE', LIMPIO Y ELEGANTE) -->
        <Border Grid.Row="2" Background="#16181D" BorderBrush="#262930" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Estado / Motor -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusDotColor}"/>
                    <TextBlock Text="{Binding EngineStateText}" Foreground="#7D8390" FontSize="11"/>
                </StackPanel>

                <!-- Live Metrics Readout -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="CPU:" Foreground="#7D8390" FontSize="11"/>
                        <TextBlock Text="{Binding CpuText}" Foreground="#F0F2F5" FontFamily="Consolas, monospace" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="RAM:" Foreground="#7D8390" FontSize="11"/>
                        <TextBlock Text="{Binding RamText}" Foreground="#F0F2F5" FontFamily="Consolas, monospace" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Red:" Foreground="#7D8390" FontSize="11"/>
                        <TextBlock Text="{Binding NetText}" Foreground="#F0F2F5" FontFamily="Consolas, monospace" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- LAN Remote Button -->
                <Button Grid.Column="2"
                        Background="#262930"
                        Foreground="#F0F2F5"
                        FontSize="11"
                        Padding="10,4"
                        Command="{Binding OpenQrModalCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconLightning}" Width="11" Height="11" Foreground="#00D2FF"/>
                        <TextBlock Text="Control LAN" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
