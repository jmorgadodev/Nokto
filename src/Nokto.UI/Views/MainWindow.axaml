<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nokto.UI.ViewModels"
        xmlns:views="using:Nokto.UI.Views"
        xmlns:coreServices="using:Nokto.Core.Services"
        xmlns:coreModels="using:Nokto.Core.Models"
        x:Class="Nokto.UI.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="Nokto — Consola de Operaciones y Control Local"
        Width="1100"
        Height="780"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="avares://Nokto/Assets/nokto.ico"
        Background="{DynamicResource ThemeBackground}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- TOP BAR / HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5">
                        <TextBlock Text="◐" Foreground="{DynamicResource ThemeAccent}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nokto" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ApplicationVersionText, FallbackValue='v1.0.1'}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="4,2,0,0"/>
                </StackPanel>

                <!-- Status Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ExitNoktoButton" Content="Salir de Nokto" Click="OnExitNoktoClick" ToolTip.Tip="Cerrar Nokto completamente y finalizar las rutinas en curso" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" FontSize="11" Padding="10,5"/>
                    <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusDotColor}"/>
                            <TextBlock Text="{Binding CurrentStatusText}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY CONTENT CON 4 PESTAÑAS (TABCONTROL) -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" Margin="12,6,12,0">

            <!-- ======================================================== -->
            <!-- PESTAÑA 0: INICIO (CABINA DE CONTROL DIARIO)             -->
            <!-- ======================================================== -->
            <TabItem FontSize="12" FontWeight="SemiBold" Header="{DynamicResource TabHome}">
                <Grid x:Name="HomeDashboardGrid" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,*" Margin="14,10,14,8">
                    <Grid.Styles>
                        <Style Selector="Border.homeCard"><Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="6"/></Style>
                        <Style Selector="TextBlock.homeHeading"><Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
                        <Style Selector="TextBlock.homeValue"><Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/><Setter Property="FontSize" Value="11"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                        <Style Selector="TextBlock.homeLabel"><Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/><Setter Property="FontSize" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
                    </Grid.Styles>
                    <Border Grid.Row="0" Grid.Column="0" Classes="homeCard" IsVisible="{Binding Config.ShowNetworkCardInHome}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="homeHeading" Text="⬡ CONEXIÓN Y RED LOCAL"/>
                            <Grid ColumnDefinitions="88,*"><TextBlock Classes="homeLabel" Text="IPv4 LAN:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding LocalIpAddress}" FontFamily="Consolas" FontWeight="SemiBold"/></Grid>
                            <Grid ColumnDefinitions="88,*"><TextBlock Classes="homeLabel" Text="Red:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding ConnectedNetworkName}" ToolTip.Tip="{Binding ConnectedNetworkName}"/></Grid>
                            <Grid ColumnDefinitions="88,*"><TextBlock Classes="homeLabel" Text="Interfaz:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding NetworkInterfaceText}" ToolTip.Tip="{Binding NetworkInterfaceText}"/></Grid>
                            <Grid ColumnDefinitions="88,*"><TextBlock Classes="homeLabel" Text="Túnel / VPN:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding VpnStatusText}" ToolTip.Tip="{Binding VpnStatusText}"/></Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Classes="homeCard" IsVisible="{Binding Config.ShowHardwareCardInHome}">
                        <StackPanel Spacing="7">
                            <TextBlock Classes="homeHeading" Text="▣ ESTACIÓN DE TRABAJO"/>
                            <Grid ColumnDefinitions="65,*"><TextBlock Classes="homeLabel" Text="SO:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding HardwareProfile.OperatingSystemDisplayText}" ToolTip.Tip="{Binding HardwareProfile.OperatingSystemName}"/></Grid>
                            <Grid ColumnDefinitions="65,*"><TextBlock Classes="homeLabel" Text="CPU:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding HardwareProfile.ProcessorName}" ToolTip.Tip="{Binding HardwareProfile.ProcessorName}"/></Grid>
                            <Grid ColumnDefinitions="65,*"><TextBlock Classes="homeLabel" Text="RAM:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding HardwareProfile.MemoryText}"/></Grid>
                            <Grid ColumnDefinitions="65,*"><TextBlock Classes="homeLabel" Text="GPU:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding HardwareProfile.GraphicsDisplayText}" ToolTip.Tip="{Binding HardwareProfile.GraphicsAdapterName}"/></Grid>
                            <Grid ColumnDefinitions="65,*"><TextBlock Classes="homeLabel" Text="Pantalla:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding HardwareProfile.MonitorsText}" ToolTip.Tip="{Binding HardwareProfile.MonitorsText}"/></Grid>
                            <Grid ColumnDefinitions="65,*"><TextBlock Classes="homeLabel" Text="Audio:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding AudioDevices.OutputCompactText}" ToolTip.Tip="{Binding AudioDevices.OutputText}" FontSize="10"/></Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Classes="homeCard" IsVisible="{Binding Config.ShowEnergyStatusCardInHome}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="homeHeading" Text="ϟ ESTADO DE TRABAJO Y ENERGÍA" Foreground="{DynamicResource ThemeAccentWarning}"/>
                            <Grid ColumnDefinitions="100,*">
                                <TextBlock Classes="homeLabel" Text="Modo Trabajo:"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StatusDotColor}" VerticalAlignment="Center"/>
                                    <TextBlock Classes="homeValue" Text="{Binding WorkModeStatusText}"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="100,*"><TextBlock Classes="homeLabel" Text="Alimentación:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding PowerSourceStatusText}" ToolTip.Tip="{Binding PowerSourceStatusText}"/></Grid>
                            <Grid ColumnDefinitions="100,*"><TextBlock Classes="homeLabel" Text="Encendido:"/><TextBlock Grid.Column="1" Classes="homeValue" Text="{Binding UptimeText}" FontFamily="Consolas"/></Grid>
                            <Button Content="{Binding KeepAliveButtonText}" Command="{Binding ToggleKeepAliveCommand}" ToolTip.Tip="{Binding WorkModeDetailText}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,6" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <views:HomeAudioView Grid.Row="1" Grid.Column="0" Margin="6" IsVisible="{Binding Config.ShowAudioControlCardInHome}"/>
                    <Border Grid.Row="1" Grid.Column="1" Classes="homeCard" IsVisible="{Binding Config.ShowAiRadarCardInHome}">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="homeHeading" Text="◈ RADAR DE HERRAMIENTAS IA"/>
                                <Button Grid.Column="1" Content="↻" Command="{Binding RefreshAiQuotasCommand}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Padding="7,3" ToolTip.Tip="Actualizar cuotas locales"/>
                            </Grid>
                            <ScrollViewer MaxHeight="208" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AiEnvironments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AiEnvironmentItem">
                                        <StackPanel>
                                            <Border IsVisible="{Binding HasExplicitQuotaMetrics}" Background="{DynamicResource ThemeInputBackground}" CornerRadius="6" Padding="9,7" Margin="0,2">
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <Button Grid.Column="1" Content="▶ Abrir" Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="10" Padding="7,3"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding Data.ActivityBadgeText}" Foreground="{DynamicResource ThemeAccent}" FontSize="10"/>
                                                        <TextBlock Grid.Column="1" Text="CUOTA RESTANTE" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Metrics}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="coreServices:AiQuotaMetric">
                                                                <Grid ColumnDefinitions="*,80,52" Margin="0,4" ToolTip.Tip="{Binding DetailText}">
                                                                    <StackPanel Spacing="2" Margin="0,0,4,0">
                                                                        <TextBlock x:Name="AiModelNameText" Text="{Binding ModelName}" IsVisible="{Binding HasModelLabel}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding WindowLabel}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                    <ProgressBar Grid.Column="1" Width="64" MinWidth="0" Value="{Binding RemainingPercent}" Minimum="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{DynamicResource ThemeAccent}" Background="{DynamicResource ThemeCardBackground}" Margin="8,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding RemainingPercent, StringFormat='{}{0:0.#}%'}" Foreground="{DynamicResource ThemeTextPrimary}" FontFamily="Consolas" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <Grid IsVisible="{Binding !HasExplicitQuotaMetrics}" ColumnDefinitions="*,Auto,Auto" Margin="0,5">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Data.LauncherBadgeText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9" MaxWidth="90" TextTrimming="CharacterEllipsis" Margin="5,0,6,0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Content="▶ Abrir" Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="10" Padding="7,4"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="Elige los accesos que quieres mostrar en Ajustes." IsVisible="{Binding !HasVisibleAiEnvironments}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Classes="homeCard" IsVisible="{Binding Config.ShowQuickActionsInHome}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="homeHeading" Text="↗ ACCIONES RÁPIDAS"/>
                            <Button Content="⏱ Temporizador Rápido" Command="{Binding NavigateToTabCommand}" CommandParameter="1" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,7"/>
                            <Button Content="↻ Ver Rutinas" Command="{Binding NavigateToTabCommand}" CommandParameter="2" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,7"/>
                            <Button Content="☾ Modo Dormir" Command="{Binding RunQuickSleepModeCommand}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccentWarning}" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,7"/>
                            <Button Content="▣ Bloquear Sesión" Command="{Binding LockSessionNowCommand}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,7"/>
                        </StackPanel>
                    </Border>
                    <views:ActiveTasksView Grid.Row="2" Grid.ColumnSpan="3" Margin="6,12,6,0" MaxHeight="270" VerticalAlignment="Stretch"/>
                </Grid>
            </TabItem>


            <!-- ======================================================== -->
            <!-- PESTAÑA 1: CONTROL MANUAL                                -->
            <!-- ======================================================== -->
            <TabItem FontSize="12" FontWeight="SemiBold" Header="{DynamicResource TabManual}">
                <views:ManualControlView/>
            </TabItem>

            <!-- ======================================================== -->
            <!-- PESTAÑA 2: RUTINAS (SUSTITUYE A MODO STUDIO)             -->
            <!-- ======================================================== -->
            <TabItem FontSize="12" FontWeight="SemiBold" Header="{DynamicResource TabRoutines}">
                <Grid ColumnDefinitions="280,14,*" Margin="10,10,10,10">

                    <!-- PANEL IZQUIERDO: LISTA DE RUTINAS GUARDADAS -->
                    <Border Grid.Column="0" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
                                <TextBlock Text="RUTINAS GUARDADAS" Foreground="{DynamicResource ThemeTextSecondary}" FontWeight="Bold" FontSize="10"/>
                                <Button Content="{DynamicResource BtnNewRoutine}" Command="{Binding NewStudioPipelineCommand}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,6"/>
                            </StackPanel>

                            <ListBox Grid.Row="1" ItemsSource="{Binding RoutineCards}" SelectedItem="{Binding SelectedRoutineItem, Mode=TwoWay}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoutineItem">
                                        <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,3">
                                            <StackPanel Spacing="3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="[SISTEMA]" IsVisible="{Binding IsSystemPreset}" Foreground="{DynamicResource ThemeAccentWarning}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </Grid>
                                                <TextBlock Text="{Binding DisplayDescription}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsRunning}">
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource ThemeAccentSuccess}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="En curso" Foreground="{DynamicResource ThemeAccentSuccess}" FontSize="10"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                                <Button Content="{DynamicResource BtnDelete}" Command="{Binding DeleteSelectedPipelineCommand}" IsEnabled="{Binding CanDeleteSelectedRoutine}" Background="#3A1A1E" Foreground="#FF5252" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Eliminar rutina seleccionada (bloqueado para plantillas de sistema)"/>
                                <Button Content="{DynamicResource BtnRestoreFactory}" Command="{Binding RestoreFactoryRoutinesCommand}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccentWarning}" FontSize="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Restaurar las rutinas de fábrica sin eliminar las personalizadas"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- PANEL DERECHO: DISPARADOR Y ACCIONES REORDENABLES -->
                    <Border Grid.Column="2" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <views:RoutineEditorView/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================================================== -->
            <!-- PESTAÑA 3: AJUSTES (CONFIGURACIÓN GLOBAL)                -->
            <!-- ======================================================== -->
            <TabItem FontSize="12" FontWeight="SemiBold" Header="{DynamicResource TabSettings}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="20,14">
                    <StackPanel Spacing="16">

                        <!-- SECCIÓN: ACTUALIZACIONES DEL SISTEMA -->
                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="ACTUALIZACIONES DEL SISTEMA" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding UpdateStatusBadgeColor}"/>
                                            <TextBlock Text="{Binding UpdateStatusBadgeText}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Versión instalada:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11"/>
                                            <TextBlock Text="{Binding ApplicationVersionText, FallbackValue='v1.0.1'}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="SemiBold" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExecutableLocationText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🔍 Comprobar actualizaciones" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !IsCheckingUpdates}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" FontWeight="SemiBold" FontSize="11" Padding="12,6"/>
                                </Grid>

                                <CheckBox IsChecked="{Binding CheckUpdatesOnStartup, Mode=TwoWay}" Content="Buscar actualizaciones automáticamente al iniciar" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>

                                <!-- Panel desplegable si hay actualización disponible -->
                                <Border IsVisible="{Binding HasUpdateAvailable}" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="¡Nueva versión lista para descargar!" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding LatestVersionText, StringFormat='Versión disponible: {0}'}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="⬇ Descargar e Instalar" Command="{Binding DownloadAndInstallUpdateCommand}" IsEnabled="{Binding !IsDownloadingUpdate}" Background="{DynamicResource ThemeAccentSuccess}" Foreground="#0E1015" FontWeight="Bold" FontSize="11" Padding="14,8"/>
                                        </Grid>

                                        <ProgressBar IsVisible="{Binding IsDownloadingUpdate}" Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" Height="6" CornerRadius="3" Foreground="{DynamicResource ThemeAccent}" Background="{DynamicResource ThemeCardBackground}"/>
                                        <TextBlock IsVisible="{Binding IsDownloadingUpdate}" Text="{Binding DownloadProgressText}" Foreground="{DynamicResource ThemeAccent}" FontSize="10" HorizontalAlignment="Right"/>

                                        <TextBlock Text="Notas de la versión:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" FontWeight="Bold"/>
                                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="10" MaxHeight="140">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{Binding ReleaseNotesText}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{DynamicResource SettingsLanguage}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11"/>
                                <Grid ColumnDefinitions="*,200">
                                    <TextBlock Grid.Column="0" Text="Seleccione el idioma de la interfaz (en caliente, sin reiniciar):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11">
                                        <ComboBoxItem Content="Español (ES)"/>
                                        <ComboBoxItem Content="English (EN)"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN 2: APARIENCIA -->
                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{DynamicResource SettingsAppearance}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11"/>
                                <Grid ColumnDefinitions="*,250">
                                    <TextBlock Grid.Column="0" Text="Selector de tema visual del sistema:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedThemeModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11">
                                        <ComboBoxItem Content="Sincronizar con Windows"/>
                                        <ComboBoxItem Content="Automático por Horario"/>
                                        <ComboBoxItem Content="Modo Día (Light)"/>
                                        <ComboBoxItem Content="Modo Noche (Dark)"/>
                                        <ComboBoxItem Content="Gris intermedio (Slate)"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Configuración de Horario para Modo Automático -->
                                <Border IsVisible="{Binding IsScheduleThemeActive}" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Intervalo Horario (evaluación pasiva cada 60s):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" FontWeight="Bold"/>
                                        <Grid ColumnDefinitions="*,Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="Hora de inicio Día:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            <TimePicker Grid.Column="1" SelectedTime="{Binding ScheduleDayTime, Mode=TwoWay}" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,14,0"/>
                                            <TextBlock Grid.Column="2" Text="Hora de inicio Noche:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            <TimePicker Grid.Column="3" SelectedTime="{Binding ScheduleNightTime, Mode=TwoWay}" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN 3: TELETRABAJO Y ARRANQUE -->
                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{DynamicResource SettingsStartup}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11"/>
                                <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Content="{DynamicResource StartWithWindows}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                                <CheckBox IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" Content="{DynamicResource StartMinimized}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                                <CheckBox x:Name="MinimizeOnCloseCheckBox" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" Content="Minimizar a la bandeja al cerrar la ventana" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                                <CheckBox IsChecked="{Binding StartInWorkMode, Mode=TwoWay}" Content="{DynamicResource StartInWorkMode}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN 4: ATAJO GLOBAL DE PÁNICO (PANIC HOTKEY) -->
                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{DynamicResource SettingsPanicHotkey}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="Detiene todas las rutinas y cuentas atrás, incluso cuando Nokto está minimizado." Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="PanicHotkeyInput" Text="{Binding PanicHotkeyText, Mode=TwoWay}" Watermark="Ej. Ctrl+Shift+F9 o Pause" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Content="Aplicar atajo" Command="{Binding ApplyPanicHotkeyCommand}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" Padding="12,6"/>
                                </Grid>
                                <TextBlock Text="{Binding PanicHotkeyStatus}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN 5: GUARDIÁN DE BATERÍA (PORTÁTILES) -->
                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{DynamicResource SettingsBattery}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11"/>
                                <CheckBox IsChecked="{Binding BatteryProtectionEnabled, Mode=TwoWay}" Content="{DynamicResource EnableBatteryProtection}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                                
                                <Grid ColumnDefinitions="*,200" IsVisible="{Binding BatteryProtectionEnabled}">
                                    <TextBlock Grid.Column="0" Text="Umbral porcentual de batería crítica:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding BatteryThresholdPercentIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11">
                                        <ComboBoxItem Content="5%"/>
                                        <ComboBoxItem Content="10% (Recomendado)"/>
                                        <ComboBoxItem Content="15%"/>
                                        <ComboBoxItem Content="20%"/>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,200" IsVisible="{Binding BatteryProtectionEnabled}">
                                    <TextBlock Grid.Column="0" Text="Acción al alcanzar el umbral sin cargador:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding BatteryActionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11">
                                        <ComboBoxItem Content="Hibernar (Cero consumo)"/>
                                        <ComboBoxItem Content="Suspender"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN 6: MODULARIDAD E INTELIGENCIA ARTIFICIAL -->
                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{DynamicResource SettingsHomeModularity}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11"/>
                                <CheckBox IsChecked="{Binding Config.ShowNetworkCardInHome, Mode=TwoWay}" Content="{DynamicResource ShowNetworkCardInHome}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                                <CheckBox IsChecked="{Binding Config.ShowEnergyStatusCardInHome, Mode=TwoWay}" Content="{DynamicResource ShowEnergyStatusCardInHome}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                                <CheckBox IsChecked="{Binding Config.ShowHardwareCardInHome, Mode=TwoWay}" Content="{DynamicResource ShowHardwareCardInHome}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                                <CheckBox IsChecked="{Binding Config.ShowAiRadarCardInHome, Mode=TwoWay}" Content="{DynamicResource ShowAiRadarCardInHome}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                                <CheckBox IsChecked="{Binding Config.ShowQuickActionsInHome, Mode=TwoWay}" Content="{DynamicResource ShowQuickActionsInHome}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                                <CheckBox IsChecked="{Binding Config.ShowAudioControlCardInHome, Mode=TwoWay}" Content="{DynamicResource ShowAudioControlCardInHome}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{DynamicResource SettingsDiskSpace}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource DiskAlertPrompt}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" VerticalAlignment="Center"/>
                                    <NumericUpDown Value="{Binding DiskAlertThresholdGb, Mode=TwoWay}" Minimum="0" Maximum="1000000" Increment="1" FormatString="F0" Width="100" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    <TextBlock Text="GB" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <views:AudioSettingsView/>

                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="HERRAMIENTAS IA · ACCESOS EN INICIO" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Detectar de nuevo" Command="{Binding RefreshAiQuotasCommand}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Padding="10,6"/>
                                </Grid>
                                <TextBlock Text="Marca los accesos que quieres ver en Inicio. Usa Subir y Bajar para elegir su prioridad: el primero aparece arriba del Radar. Tu selección y orden se guardan en este equipo." Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding DetectedAiEnvironments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AiEnvironmentItem">
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                                                <StackPanel Margin="0,0,12,0">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding ShowInHome, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" ToolTip.Tip="{Binding DetectionDetailsText}"/>
                                                    <TextBlock Text="{Binding QuotaAvailabilityText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" Margin="28,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Button Content="↑ Subir" Command="{Binding MoveUpCommand}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" Padding="8,5" ToolTip.Tip="Subir la prioridad en el Radar"/>
                                                    <Button Content="↓ Bajar" Command="{Binding MoveDownCommand}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" Padding="8,5" ToolTip.Tip="Bajar la prioridad en el Radar"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Abrir" Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Padding="10,5" VerticalAlignment="Center" ToolTip.Tip="{Binding DetectionDetailsText}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No se detectaron herramientas compatibles. Instálalas y pulsa Detectar de nuevo." IsVisible="{Binding !HasDetectedAiEnvironments}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeAccentWarning}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="AVISO · CUOTAS LOCALES" Foreground="{DynamicResource ThemeAccentWarning}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="Nokto solo muestra tokens o cuotas restantes cuando el servicio guarda esa información localmente y permite leerla sin autenticación. Nokto no se conecta a los proveedores ni valida cuentas o credenciales. Si no hay datos compatibles, solo se muestra el acceso directo; no se calculan ni estiman cuotas." Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnDefinitions="*,180">
                                <StackPanel Spacing="10" Margin="0,0,18,0">
                                    <TextBlock Text="CONTROL REMOTO MÓVIL · LAN" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11"/>
                                    <CheckBox Content="Habilitar Control Remoto Móvil (LAN)" IsChecked="{Binding RemoteControlEnabled, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="Puerto local:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                        <NumericUpDown Value="{Binding RemoteControlPort, Mode=TwoWay}" Minimum="1024" Maximum="65535" Increment="1" FormatString="0" Width="120" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RemoteBaseUrl}" Foreground="{DynamicResource ThemeAccent}" FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Text="{Binding RemoteServerStatusText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Abrir control móvil" Command="{Binding OpenRemoteControlCommand}" IsEnabled="{Binding RemoteServerRunning}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Padding="10,6"/>
                                        <Button Content="Reintentar" Command="{Binding RetryRemoteServerCommand}" IsEnabled="{Binding RemoteControlEnabled}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Padding="10,6"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding RemoteServerRunning}">
                                    <Border Background="White" Padding="8" CornerRadius="6" HorizontalAlignment="Center">
                                        <Image Source="{Binding RemoteQrCode}" Width="160" Height="160" Stretch="Uniform" AutomationProperties.Name="Código QR de conexión al control móvil"/>
                                    </Border>
                                    <TextBlock Text="Escanea para conectar" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- SECCIÓN 7: EVIDENCIAS Y MANTENIMIENTO -->
                        <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{DynamicResource SettingsEvidence}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="11"/>
                                <CheckBox IsChecked="{Binding EvidenceScreenshotsEnabled, Mode=TwoWay}" Content="{DynamicResource TakeEvidenceScreenshots}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Button Content="{DynamicResource BtnViewGallery}" Command="{Binding OpenEvidenceGalleryCommand}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" FontSize="11" Padding="12,6"/>
                                    <Button Content="{DynamicResource BtnOpenData}" Command="{Binding OpenDataFolderCommand}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" Padding="12,6"/>
                                    <Button Content="{DynamicResource BtnResetSettings}" Command="{Binding ResetSettingsCommand}" Background="#3A1A1E" Foreground="#FF5252" FontSize="11" Padding="12,6"/>
                                </StackPanel>

                                <!-- MODAL / VISTA DE GALERÍA DE EVIDENCIAS -->
                                <Border IsVisible="{Binding IsEvidenceGalleryOpen}" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="Galería de Capturas de Evidencia" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="🗑 Purgar Todo" Command="{Binding CleanEvidenceCommand}" Background="#3A1A1E" Foreground="#FF5252" FontSize="10" Padding="8,4" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="✕ Cerrar" Command="{Binding CloseEvidenceGalleryCommand}" Background="{DynamicResource ThemeCardBackground}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" Padding="8,4"/>
                                        </Grid>

                                        <ListBox ItemsSource="{Binding EvidenceGalleryItems}" Height="140" Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EvidenceItem">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding FileName}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TimestampText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" Margin="10,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding FileSizeText}" Foreground="{DynamicResource ThemeAccent}" FontSize="10"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN ACERCA DE NOKTO -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,15,0,25" Padding="20">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Text="ACERCA DE NOKTO"/>
                                    <Border Background="#1E293B" CornerRadius="4" Grid.Column="1" Padding="8,2">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Text="{Binding ApplicationVersionText, FallbackValue='v1.0.1'}"/>
                                    </Border>
                                </Grid>

                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Creado por Jorge Morgado"/>

                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="Consola local de operaciones, telemetría y automatización de escritorio determinista." TextWrapping="Wrap"/>

                                <!-- BOTONERA DE ENLACES (VISIBILIDAD FORZADA) -->
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="12">
                                    <Button Background="#0A66C2" Command="{Binding OpenLinkedInCommand}" Click="OnOpenLinkedInClick" CornerRadius="6" Cursor="Hand" Foreground="White" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🌐"/>
                                            <TextBlock FontWeight="Medium" Text="LinkedIn / Perfil Profesional"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Background="#24292F" Command="{Binding OpenGitHubCommand}" Click="OnOpenGitHubClick" CornerRadius="6" Cursor="Hand" Foreground="White" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🐙"/>
                                            <TextBlock FontWeight="Medium" Text="Repositorio GitHub"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button x:Name="RemoteConnectionButton" Grid.Row="1" IsVisible="{Binding RemoteControlEnabled}" Content="Conectar móvil · QR"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,28,0" Padding="12,6" MinHeight="30" FontSize="11"
                Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}"
                BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" AutomationProperties.Name="Mostrar QR para conectar el móvil">
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                    <Border Background="{DynamicResource ThemeCardBackground}" Padding="12" CornerRadius="8">
                        <StackPanel Width="280" Spacing="12">
                            <TextBlock Text="CONECTAR MÓVIL" Foreground="{DynamicResource ThemeAccent}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Escanea el QR con el teléfono conectado a la misma red Wi-Fi." Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                            <Border Background="White" Padding="8" CornerRadius="6" HorizontalAlignment="Center" IsVisible="{Binding RemoteServerRunning}">
                                <Image Source="{Binding RemoteQrCode}" Width="160" Height="160" Stretch="Uniform" AutomationProperties.Name="Código QR para conectar el móvil"/>
                            </Border>
                            <TextBlock Text="{Binding RemoteBaseUrl}" Foreground="{DynamicResource ThemeAccent}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding RemoteServerStatusText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                            <Button Content="Reintentar conexión" Command="{Binding RetryRemoteServerCommand}" IsVisible="{Binding !RemoteServerRunning}" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- FOOTER / BARRA INFERIOR DE TELEMETRÍA (5 MÉTRICAS COMPACTAS CON ICONOS TÉCNICOS Y TOOLTIPS) -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeFooterBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,1,0,0" Padding="18,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Estado del Motor (Izquierda) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusDotColor}"/>
                    <TextBlock Text="{Binding EngineStateText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11"/>
                </StackPanel>

                <!-- Estado Central de la Tarea -->
                <Border Grid.Column="1" Background="{DynamicResource ThemeInputBackground}" CornerRadius="4" Padding="8,3" Margin="12,0" MaxWidth="220" VerticalAlignment="Center" ClipToBounds="True" ToolTip.Tip="{Binding FooterTaskToolTip}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ThemeAccentSuccess}" IsVisible="{Binding HasActiveRoutines}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding FooterTaskText}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding TimeRemainingText}" IsVisible="{Binding IsSingleRoutineActive}" Margin="8,0,0,0" Foreground="{DynamicResource ThemeAccent}" FontFamily="Consolas, monospace" FontSize="10" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 5 Métricas compactas con Iconos Técnicos y ToolTips (Derecha) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- CPU -->
                    <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" MinWidth="95" Width="95" ClipToBounds="True" ToolTip.Tip="{Binding CpuToolTip}">
                        <Grid ColumnDefinitions="11,*" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconCpuSilicon}" Width="11" Height="11" Foreground="{DynamicResource ThemeAccent}"/>
                            <TextBlock Grid.Column="1" Margin="5,0,0,0" FontFeatures="+tnum" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding CpuText}" Foreground="{DynamicResource ThemeTextPrimary}" FontFamily="Consolas, monospace" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- RAM -->
                    <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" MinWidth="95" Width="95" ClipToBounds="True" ToolTip.Tip="{Binding RamToolTip}">
                        <Grid ColumnDefinitions="11,*" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconRamDimm}" Width="11" Height="11" Foreground="{DynamicResource ThemeAccent}"/>
                            <TextBlock Grid.Column="1" Margin="5,0,0,0" FontFeatures="+tnum" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding RamText}" Foreground="{DynamicResource ThemeTextPrimary}" FontFamily="Consolas, monospace" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- GPU -->
                    <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" MinWidth="90" Width="90" ClipToBounds="True" ToolTip.Tip="{Binding GpuToolTip}">
                        <Grid ColumnDefinitions="11,*" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconGpuAxial}" Width="11" Height="11" Foreground="{DynamicResource ThemeAccent}"/>
                            <TextBlock Grid.Column="1" Margin="5,0,0,0" FontFeatures="+tnum" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding GpuText}" Foreground="{DynamicResource ThemeTextPrimary}" FontFamily="Consolas, monospace" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Disco -->
                    <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" MinWidth="195" Width="195" ClipToBounds="True" ToolTip.Tip="{Binding DiskToolTip}">
                        <Grid ColumnDefinitions="11,*" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconDiskFlash}" Width="11" Height="11" Foreground="{DynamicResource ThemeAccent}"/>
                            <TextBlock Grid.Column="1" Margin="5,0,0,0" FontFeatures="+tnum" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding DiskFooterText}" Classes.diskWarning="{Binding IsDiskSpaceLow}" FontFamily="Consolas, monospace" FontSize="11" VerticalAlignment="Center">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                    </Style>
                                    <Style Selector="TextBlock.diskWarning">
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentWarning}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Red -->
                    <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" MinWidth="115" Width="115" ClipToBounds="True" ToolTip.Tip="{Binding NetToolTip}">
                        <Grid ColumnDefinitions="11,*" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconNetPulse}" Width="11" Height="11" Foreground="{DynamicResource ThemeAccent}"/>
                            <TextBlock Grid.Column="1" Margin="5,0,0,0" FontFeatures="+tnum" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding NetText}" Foreground="{DynamicResource ThemeTextPrimary}" FontFamily="Consolas, monospace" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
