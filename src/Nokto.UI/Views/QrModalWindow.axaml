<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nokto.UI.Views.QrModalWindow"
        Title="Control Remoto LAN — Nokto"
        Width="380" Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0E0F12"
        ExtendClientAreaToDecorationsHint="True">

    <Border Background="#0E0F12" Padding="24">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <TextBlock Text="📱 Control Remoto LAN"
                           Foreground="#F0F2F5"
                           FontWeight="Bold"
                           FontSize="18"/>
                <TextBlock Text="Escanea con la cámara de tu móvil conectado a la misma red Wi-Fi"
                           Foreground="#7D8390"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </StackPanel>

            <!-- QR Container -->
            <Border Grid.Row="2"
                    Background="#16181D"
                    BorderBrush="#262930"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <!-- QR Simulado con Canvas / Vectores -->
                    <Border Width="160" Height="160" Background="#FFFFFF" CornerRadius="8" Padding="12">
                        <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*">
                            <Border Grid.Row="0" Grid.Column="0" Background="#000000" CornerRadius="3" Margin="2"/>
                            <Border Grid.Row="0" Grid.Column="2" Background="#000000" CornerRadius="3" Margin="2"/>
                            <Border Grid.Row="1" Grid.Column="1" Background="#000000" CornerRadius="3" Margin="2"/>
                            <Border Grid.Row="2" Grid.Column="0" Background="#000000" CornerRadius="3" Margin="2"/>
                            <Border Grid.Row="2" Grid.Column="2" Background="#00D2FF" CornerRadius="3" Margin="2"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TxtUrl"
                               Text="http://localhost:4884/?auth=a9f82d1c"
                               Foreground="#00D2FF"
                               FontFamily="Consolas, monospace"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Copy button -->
            <Button Grid.Row="3"
                    x:Name="BtnCopy"
                    Content="📋 Copiar Enlace Directo"
                    Background="#262930"
                    Foreground="#F0F2F5"
                    FontSize="12"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,16,0,8"
                    Padding="0,8"
                    Click="OnCopyClicked"/>

            <!-- Close button -->
            <Button Grid.Row="4"
                    Content="Cerrar"
                    Background="Transparent"
                    Foreground="#7D8390"
                    FontSize="12"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnCloseClicked"/>
        </Grid>
    </Border>
</Window>
