<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nokto.UI.Controls"
             x:Class="Nokto.UI.Views.IslandSettingsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="22,18" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          HorizontalAlignment="Stretch">
      <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{DynamicResource IslandTitle}"
                 Foreground="{DynamicResource ThemeTextPrimary}" FontSize="23" FontWeight="Bold" Margin="0,0,0,4"/>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{DynamicResource IslandIntro}"
                 Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

      <Border Grid.Row="2" Grid.Column="0" Margin="0,0,8,14" Padding="16" CornerRadius="12"
              Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource IslandVisibilityHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold"/>
          <CheckBox Content="{DynamicResource IslandEnable}" IsChecked="{Binding IslandVm.Enabled, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <TextBlock Text="{DynamicResource IslandEnableHint}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Grid.Column="1" Margin="8,0,0,14" Padding="16" CornerRadius="12"
              Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource IslandStartupHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold"/>
          <ComboBox SelectedIndex="{Binding IslandVm.StartupModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="{DynamicResource IslandStartupLegacy}"/>
            <ComboBoxItem Content="{DynamicResource IslandStartupDashboard}"/>
            <ComboBoxItem Content="{DynamicResource IslandStartupIsland}"/>
            <ComboBoxItem Content="{DynamicResource IslandStartupBoth}"/>
            <ComboBoxItem Content="{DynamicResource IslandStartupTray}"/>
          </ComboBox>
          <TextBlock Text="{DynamicResource IslandStartupNote}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Grid.Column="0" Margin="0,0,8,14" Padding="16" CornerRadius="12"
              Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource IslandAppearanceHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold"/>
          <TextBlock Text="{DynamicResource IslandStyleLabel}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <ComboBox SelectedIndex="{Binding IslandVm.StyleIndex, Mode=TwoWay}"
                    ItemsSource="{Binding IslandVm.EyeStyleOptions}"
                    AutomationProperties.AutomationId="IslandEyeStyleSelector" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Border CornerRadius="10" Background="#080B10" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
              <TextBlock Text="{DynamicResource IslandEyePreview}" VerticalAlignment="Center" Foreground="#B7CDDD" FontSize="11"/>
              <controls:NoktoEyesControl Width="145" Height="68" StyleId="{Binding IslandVm.SelectedStyle}"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{DynamicResource IslandSizeLabel}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <Grid ColumnDefinitions="*,54">
            <Slider Grid.Column="0" Minimum="80" Maximum="140" TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="{Binding IslandVm.SizePercent, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandSizeSlider"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="{Binding IslandVm.SizePercent, StringFormat='{}{0}%'}"
                       Foreground="{DynamicResource ThemeAccent}" FontFamily="Consolas"/>
          </Grid>
          <TextBlock Text="{DynamicResource IslandSizeHint}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource IslandClockBehavior}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <ComboBox SelectedIndex="{Binding IslandVm.ClockModeIndex, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandClockVisibilitySelector">
            <ComboBoxItem Content="{DynamicResource IslandClockExpand}"/>
            <ComboBoxItem Content="{DynamicResource IslandClockAlways}"/>
            <ComboBoxItem Content="{DynamicResource IslandClockNever}"/>
          </ComboBox>
        </StackPanel>
      </Border>
      <Border Grid.Row="3" Grid.Column="1" Margin="8,0,0,14" Padding="16" CornerRadius="12"
              Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource IslandEyeMotionHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold"/>
          <CheckBox Content="{DynamicResource IslandFollowCursor}" IsChecked="{Binding IslandVm.FollowCursor, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandNaturalBlink}" IsChecked="{Binding IslandVm.NaturalBlink, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandSleepOnIdle}" IsChecked="{Binding IslandVm.SleepOnIdle, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <TextBlock Text="{DynamicResource IslandEyeSensitivity}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <Slider Minimum="0" Maximum="1" TickFrequency="0.1" Value="{Binding IslandVm.EyeSensitivity, Mode=TwoWay}"
                  AutomationProperties.AutomationId="IslandEyeSensitivitySlider"/>
          <CheckBox Content="{DynamicResource IslandExpandOnHover}" IsChecked="{Binding IslandVm.ExpandOnHover, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandReducedMotion}" IsChecked="{Binding IslandVm.ReducedMotion, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandWheelEnabled}" IsChecked="{Binding IslandVm.EnableWheelPages, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandWheelEnabled" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <TextBlock Text="{DynamicResource IslandWheelHint}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Grid.ColumnSpan="2" Padding="16" Margin="0,0,0,14" CornerRadius="12"
              Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,230">
            <StackPanel Spacing="5">
              <TextBlock Text="{DynamicResource IslandGalleryHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold"/>
              <TextBlock Text="{DynamicResource IslandGalleryGuide}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
            <ComboBox Grid.Column="1" SelectedIndex="{Binding IslandVm.GalleryPackIndex, Mode=TwoWay}"
                      AutomationProperties.AutomationId="IslandGalleryPackFilter">
              <ComboBoxItem Content="{DynamicResource IslandGalleryAll}"/>
              <ComboBoxItem Content="Minimal"/>
              <ComboBoxItem Content="Nokto"/>
              <ComboBoxItem Content="Cyber"/>
              <ComboBoxItem Content="Anime"/>
              <ComboBoxItem Content="Creature"/>
              <ComboBoxItem Content="Cute"/>
              <ComboBoxItem Content="Dark"/>
            </ComboBox>
          </Grid>
          <Button Content="{DynamicResource IslandNoIndicator}" CommandParameter="None" Click="OnSelectEyeStyle"
                  AutomationProperties.AutomationId="IslandNoIndicator" HorizontalAlignment="Left" Padding="12,7"/>
          <ScrollViewer Height="302" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding IslandVm.GalleryStyles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="164" ItemHeight="120"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Click="OnSelectEyeStyle" CommandParameter="{Binding Id}"
                          AutomationProperties.AutomationId="{Binding Id}"
                          AutomationProperties.Name="{Binding DisplayName}"
                          BorderBrush="{Binding SelectionStroke}" Background="{Binding SelectionFill}"
                          BorderThickness="2" CornerRadius="12" Padding="7" Margin="4">
                    <StackPanel HorizontalAlignment="Center" Spacing="5">
                      <controls:NoktoEyesControl StyleId="{Binding Id}" Width="118" Height="64"/>
                      <TextBlock Text="{Binding DisplayName}" FontSize="10"
                                 Foreground="#E6F2FA" MaxWidth="140" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Grid.Row="5" Grid.Column="0" Margin="0,0,8,14" Padding="16" CornerRadius="12"
              Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource IslandSystemControls}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold"/>
          <CheckBox Content="{DynamicResource IslandShowAudioControls}" IsChecked="{Binding IslandVm.ShowAudioControls, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandShowBatteryStatus}" IsChecked="{Binding IslandVm.ShowBatteryStatus, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandShowNetworkStatus}" IsChecked="{Binding IslandVm.ShowNetworkStatus, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <TextBlock Text="{DynamicResource IslandQuickHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" Margin="0,8,0,0"/>
          <CheckBox Content="{DynamicResource IslandQuickEnabled}" IsChecked="{Binding IslandVm.ShowQuickActions, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandQuickEnabled" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <TextBlock Text="{DynamicResource IslandQuickHint}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="5" Grid.Column="1" Margin="8,0,0,14" Padding="16" CornerRadius="12"
              Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource IslandMediaHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold"/>
          <CheckBox Content="{DynamicResource IslandMediaControls}" IsChecked="{Binding IslandVm.ShowMediaControls, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandMediaControls" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandMediaCompact}" IsChecked="{Binding IslandVm.ShowMediaInCompact, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandMediaCompact" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <TextBlock Text="{DynamicResource IslandMediaNote}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="6" Grid.Column="0" Margin="0,0,8,14" Padding="16" CornerRadius="12"
              Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
        <StackPanel Spacing="9">
          <TextBlock Text="{DynamicResource IslandShelfHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold"/>
          <CheckBox Content="{DynamicResource IslandShelfToggle}" IsChecked="{Binding IslandVm.ShowFileShelf, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandShelfEnabled" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <TextBlock Text="{DynamicResource IslandShelfInfo}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource IslandClipboardHeading}" Foreground="{DynamicResource ThemeAccent}" Margin="0,6,0,0" FontWeight="Bold"/>
          <CheckBox Content="{DynamicResource IslandClipboardEnable}" IsChecked="{Binding IslandVm.ShowClipboardActions, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandClipboardEnabled" Foreground="{DynamicResource ThemeTextPrimary}"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="6" Grid.Column="1" Margin="8,0,0,14" Padding="16" CornerRadius="12"
              Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
        <StackPanel Spacing="9">
          <TextBlock Text="{DynamicResource IslandPerformanceHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold"/>
          <TextBlock Text="{DynamicResource IslandPerformanceDescription}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource IslandAnimationRateLabel}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <ComboBox SelectedIndex="{Binding IslandVm.AnimationRateIndex, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandFrameRateSelector">
            <ComboBoxItem Content="{DynamicResource IslandFpsAuto}"/>
            <ComboBoxItem Content="60 FPS"/>
            <ComboBoxItem Content="120 FPS"/>
            <ComboBoxItem Content="144 FPS"/>
            <ComboBoxItem Content="165 FPS"/>
            <ComboBoxItem Content="240 FPS"/>
          </ComboBox>
          <TextBlock Text="{Binding IslandVm.DisplayRefreshStatus}" Foreground="{DynamicResource ThemeAccent}" FontFamily="Consolas"/>
          <TextBlock Text="{DynamicResource IslandPerformanceNote}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="7" Grid.ColumnSpan="2" Padding="16" Margin="0,0,0,14" CornerRadius="12"
              Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="5">
            <TextBlock Text="{DynamicResource IslandProductivityHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold"/>
            <TextBlock Text="{DynamicResource IslandRoutinesInfo}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Column="1" Content="{DynamicResource IslandOpenRoutines}" Click="OnOpenRoutines"
                  AutomationProperties.AutomationId="IslandOpenRoutines" Padding="14,7" Margin="14,0,0,0"
                  VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>