<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nokto.UI.Controls"
             x:Class="Nokto.UI.Views.IslandSettingsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18" Spacing="18" MaxWidth="850" HorizontalAlignment="Left">
      <TextBlock Text="{DynamicResource IslandTitle}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="22" FontWeight="Bold"/>
      <TextBlock Text="{DynamicResource IslandIntro}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" TextWrapping="Wrap"/>
      <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource IslandVisibilityHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="12"/>
          <CheckBox Content="{DynamicResource IslandEnable}" IsChecked="{Binding IslandVm.Enabled, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="14"/>
          <TextBlock Text="{DynamicResource IslandEnableHint}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource IslandAppearanceHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="12"/>
          <Grid ColumnDefinitions="250,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Text="{DynamicResource IslandStyleLabel}" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" Grid.Row="0" SelectedIndex="{Binding IslandVm.StyleIndex, Mode=TwoWay}"
                      ItemsSource="{Binding IslandVm.EyeStyleOptions}"
                      AutomationProperties.AutomationId="IslandEyeStyleSelector"
                      MinWidth="330" HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource IslandClockBehavior}" Margin="0,14,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimary}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" SelectedIndex="{Binding IslandVm.ClockModeIndex, Mode=TwoWay}"
                      AutomationProperties.AutomationId="IslandClockVisibilitySelector">
              <ComboBoxItem Content="{DynamicResource IslandClockExpand}"/>
              <ComboBoxItem Content="{DynamicResource IslandClockAlways}"/>
              <ComboBoxItem Content="{DynamicResource IslandClockNever}"/>
            </ComboBox>
          </Grid>
          <Border CornerRadius="10" Background="#080B10" Padding="10" HorizontalAlignment="Left" MinWidth="175">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Text="{DynamicResource IslandEyePreview}" VerticalAlignment="Center" Foreground="#9EADB9" FontSize="11"/>
              <controls:NoktoEyesControl Width="140" Height="64" StyleId="{Binding IslandVm.SelectedStyle}"/>
            </StackPanel>
          </Border>
          <Expander Header="{DynamicResource IslandGalleryHeading}" IsExpanded="False">
            <ItemsControl ItemsSource="{Binding IslandVm.EyeStyleOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemWidth="150" ItemHeight="104"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#0A111D" BorderBrush="#293B4B" BorderThickness="1"
                          CornerRadius="9" Margin="3" Padding="7">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                      <controls:NoktoEyesControl StyleId="{Binding Id}" Width="110" Height="55"/>
                      <TextBlock Text="{Binding DisplayName}" FontSize="10"
                                 Foreground="#D7E5F2" MaxWidth="140" TextTrimming="CharacterEllipsis"
                                 TextAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
          <TextBlock Text="{DynamicResource IslandEyeMotionHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="SemiBold" FontSize="12"/>
          <CheckBox Content="{DynamicResource IslandFollowCursor}" IsChecked="{Binding IslandVm.FollowCursor, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandNaturalBlink}" IsChecked="{Binding IslandVm.NaturalBlink, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandSleepOnIdle}" IsChecked="{Binding IslandVm.SleepOnIdle, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <Grid ColumnDefinitions="250,220">
            <TextBlock Text="{DynamicResource IslandEyeSensitivity}" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.1"
                    Value="{Binding IslandVm.EyeSensitivity, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandEyeSensitivitySlider"/>
          </Grid>
          <TextBlock Text="{DynamicResource IslandEyeMotionNote}" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" FontSize="11"/>
          <CheckBox Content="{DynamicResource IslandExpandOnHover}" IsChecked="{Binding IslandVm.ExpandOnHover, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandReducedMotion}" IsChecked="{Binding IslandVm.ReducedMotion, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <TextBlock Text="{DynamicResource IslandAppearanceHint}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource IslandSystemControls}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="12"/>
          <CheckBox Content="{DynamicResource IslandShowAudioControls}" IsChecked="{Binding IslandVm.ShowAudioControls, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandShowBatteryStatus}" IsChecked="{Binding IslandVm.ShowBatteryStatus, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandShowNetworkStatus}" IsChecked="{Binding IslandVm.ShowNetworkStatus, Mode=TwoWay}" Foreground="{DynamicResource ThemeTextPrimary}"/>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource IslandMediaHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="12"/>
          <CheckBox Content="{DynamicResource IslandMediaControls}" IsChecked="{Binding IslandVm.ShowMediaControls, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandMediaControls" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <CheckBox Content="{DynamicResource IslandMediaCompact}" IsChecked="{Binding IslandVm.ShowMediaInCompact, Mode=TwoWay}"
                    AutomationProperties.AutomationId="IslandMediaCompact" Foreground="{DynamicResource ThemeTextPrimary}"/>
          <TextBlock Text="{DynamicResource IslandMediaNote}" Foreground="{DynamicResource ThemeTextSecondary}"
                     FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource IslandPerformanceHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="12"/>
          <TextBlock Text="{DynamicResource IslandPerformanceDescription}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="250,*">
            <TextBlock Text="{DynamicResource IslandAnimationRateLabel}" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" SelectedIndex="{Binding IslandVm.AnimationRateIndex, Mode=TwoWay}"
                      AutomationProperties.AutomationId="IslandFrameRateSelector"
                      AutomationProperties.Name="{DynamicResource IslandAnimationRateLabel}"
                      MinWidth="230" HorizontalAlignment="Left">
              <ComboBoxItem Content="{DynamicResource IslandFpsAuto}"/>
              <ComboBoxItem Content="60 FPS"/>
              <ComboBoxItem Content="120 FPS"/>
              <ComboBoxItem Content="144 FPS"/>
              <ComboBoxItem Content="165 FPS"/>
              <ComboBoxItem Content="240 FPS"/>
            </ComboBox>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{DynamicResource IslandDetectedRateLabel}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12"/>
            <TextBlock Text="{Binding IslandVm.DisplayRefreshStatus}" Foreground="{DynamicResource ThemeAccent}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock Text="{DynamicResource IslandPerformanceNote}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource ThemeCardBackground}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource IslandStartupHeading}" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" FontSize="12"/>
          <TextBlock Text="{DynamicResource IslandStartupDescription}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
          <ComboBox SelectedIndex="{Binding IslandVm.StartupModeIndex, Mode=TwoWay}" MinWidth="260" HorizontalAlignment="Left">
            <ComboBoxItem Content="{DynamicResource IslandStartupLegacy}"/>
            <ComboBoxItem Content="{DynamicResource IslandStartupDashboard}"/>
            <ComboBoxItem Content="{DynamicResource IslandStartupIsland}"/>
            <ComboBoxItem Content="{DynamicResource IslandStartupBoth}"/>
            <ComboBoxItem Content="{DynamicResource IslandStartupTray}"/>
          </ComboBox>
          <TextBlock Text="{DynamicResource IslandStartupNote}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock Text="{DynamicResource IslandNextSteps}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>