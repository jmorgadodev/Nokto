    <Application.Styles>
        <FluentTheme />
        
        <!-- Estilos globales para controles neominimalistas -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Border">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </Application.Styles>
</Application>
